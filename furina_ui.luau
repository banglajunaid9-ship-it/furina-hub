	else
		o = text({ Text = tostring(name):sub(1, 1):upper(), TextSize = math.floor(size * 0.8), FontFace = F_BOLD,
			TextXAlignment = Enum.TextXAlignment.Center, Size = off(size, size), Parent = parent })
		if key then bind(o, { TextColor3 = key }) end
	end
	return o
end
local function soft(props)
	if not Assets.soft then return nil end
	props.Image = Assets.soft
	return image(props)
end

