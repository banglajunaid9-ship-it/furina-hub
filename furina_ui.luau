}
local ACCENT_ORDER = { "Hydro", "Gold", "Teal", "Rose", "Violet" }
local C = {}
local function computeTheme()
	local th = THEMES[S.Theme] or THEMES.Ousia
	for k, v in pairs(th) do
		C[k] = v
	end
	local a = ACCENTS[S.Accent] or ACCENTS.Hydro
	local light = S.Theme == "Pneuma"
	C.hydro = light and a[3] or a[1]
	C.aqua = light and a[4] or a[2]
	C.glassT = math.clamp(S.Glass / 100, 0, 0.6)
	C.accentSeq = ColorSequence.new(C.hydro, C.aqua)
	C.goldSeq = ColorSequence.new({
		ColorSequenceKeypoint.new(0, C.gold), ColorSequenceKeypoint.new(0.5, C.aqua), ColorSequenceKeypoint.new(1, C.gold),
	})
	C.bgSeq = ColorSequence.new(C.bg2, C.bg)
end

computeTheme()

local bindings = setmetatable({}, { __mode = "k" })
local function bind(obj, map)
	local b = bindings[obj] or {}
	for prop, key in pairs(map) do
		b[prop] = key
		obj[prop] = type(key) == "function" and key(C) or C[key]
	end
	bindings[obj] = b
	return obj
end
local function applyTheme()
	for obj, map in pairs(bindings) do
		if obj.Parent then
			for prop, key in pairs(map) do
				pcall(function() obj[prop] = type(key) == "function" and key(C) or C[key] end)
			end
		end
	end
end

------------------------------------------------------------------------------------------------------
-- runtime: connections, a job runner that sleeps when idle, and pausable looping tweens
------------------------------------------------------------------------------------------------------
local conns = {}
local function on(sig, fn)
	local c = sig:Connect(fn)
	conns[#conns + 1] = c
	return c
end
local jobs, hb = {}, nil
local function runJob(fn)
	jobs[fn] = true
	if hb then return end
	hb = RunService.Heartbeat:Connect(function(dt)
		for f in pairs(jobs) do
			local ok, keep = pcall(f, dt)
			if not ok then warn("[FurinaUI] " .. tostring(keep)) end
			if not ok or not keep then jobs[f] = nil end
		end
		if next(jobs) == nil and hb then
			hb:Disconnect()
			hb = nil
		end
	end)
end
local loops = {}
local function loop(group, obj, info, props)
	local t = TweenService:Create(obj, info, props)
	loops[group] = loops[group] or {}
	table.insert(loops[group], t)
	t:Play()
	return t
end
local function setLoops(group, playing)
	local list = loops[group]
	if not list then return end
	for i = #list, 1, -1 do
		local t = list[i]
		if not t.Instance or not t.Instance.Parent then
			table.remove(list, i)
		elseif playing then
			t:Play()
		else
			t:Pause()
		end
	end
end

