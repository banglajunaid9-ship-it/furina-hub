------------------------------------------------------------------------------------------------------
-- effects: ripples, splashes, drips
------------------------------------------------------------------------------------------------------
local function mouseIn(obj, scale)
	local m = UserInputService:GetMouseLocation()
	return (m.X - obj.AbsolutePosition.X) / scale, (m.Y - obj.AbsolutePosition.Y) / scale
end
local function ripple(face, scale, color)
	if LITE then return end
	local x, y = mouseIn(face, scale)
	for i = 0, 1 do
		local r = frame({ BackgroundTransparency = 1, AnchorPoint = V2(0.5, 0.5), Position = off(x, y), Size = off(6, 6), ZIndex = 8, Parent = face })
		corner(r, -1)
		local st = strokeOf(r, color or C.aqua, 1.5, 0.15)
		tw(r, 0.6, { Size = off(220, 220) }, EQ.Quint, ED.Out, i * 0.09)
		tw(st, 0.6, { Transparency = 1 }, EQ.Quint, ED.Out, i * 0.09)
		task.delay(0.8, function() r:Destroy() end)
	end
end
local function splash(obj, colors, n)
	if LITE or S.Calm or not fxLayer then return end
	local p, sz = obj.AbsolutePosition, obj.AbsoluteSize
	local cx, cy = p.X + sz.X / 2, p.Y + sz.Y / 2
	n = n or 8
	for i = 1, n do
		local d = frame({ AnchorPoint = V2(0.5, 0.5), Position = off(cx, cy), Size = off(5, 5), BackgroundColor3 = colors[(i - 1) % #colors + 1], Parent = fxLayer })
		corner(d, -1)
		local a = (i / n) * math.pi * 2 + math.random() * 0.6
		local dist = 16 + math.random() * 20
		tw(d, 0.45 + math.random() * 0.2, { Position = off(cx + math.cos(a) * dist, cy + math.sin(a) * dist), Size = off(1, 1), BackgroundTransparency = 1 }, EQ.Quart)
		task.delay(0.7, function() d:Destroy() end)
	end
end
local function drip(x, y, vx)
	if not fxLayer then return end
	local d = frame({ AnchorPoint = V2(0.5, 0.5), Position = off(x, y), Size = off(7, 9), BackgroundColor3 = C.aqua, BackgroundTransparency = 0.1, Parent = fxLayer })
	corner(d, -1)
	local floor = fxLayer.AbsoluteSize.Y - 6
	local t = math.sqrt(math.max(1, floor - y) / 900)
	tw(d, t, { Position = off(x + vx * 12, floor) }, EQ.Quad, ED.In)
	task.delay(t, function()
		d:Destroy()
		local ring = frame({ BackgroundTransparency = 1, AnchorPoint = V2(0.5, 0.5), Position = off(x + vx * 12, floor), Size = off(12, 4), Parent = fxLayer })
		corner(ring, -1)
		local st = strokeOf(ring, C.aqua, 1.5, 0.2)
		tw(ring, 0.5, { Size = off(40, 10) })
		tw(st, 0.5, { Transparency = 1 })
		task.delay(0.55, function() ring:Destroy() end)
	end)
end

