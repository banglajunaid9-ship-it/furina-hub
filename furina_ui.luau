local sounds = {}
local lastTick = 0
local function sfx(name)
	if not S.Sound or S.Volume <= 0 then return end
	if name == "tick" then
		local now = os.clock()
		if now - lastTick < 0.045 then return end
		lastTick = now
	end
	local s = sounds[name]
	if s then
		s.Volume = S.Volume / 100 * 0.8
		pcall(function() SoundService:PlayLocalSound(s) end)
	end
end

