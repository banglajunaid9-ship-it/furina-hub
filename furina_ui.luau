-- asset pack (images + sounds written to the workspace folder and loaded with getcustomasset)
------------------------------------------------------------------------------------------------------
local Assets = {}
local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function b64decode(data)
	local native = (type(crypt) == "table" and (crypt.base64decode or (type(crypt.base64) == "table" and crypt.base64.decode)))
		or (type(base64_decode) == "function" and base64_decode)
	if type(native) == "function" then
		local ok, out = pcall(native, data)
		if ok and type(out) == "string" and #out > 0 then return out end
	end
	local map = {}
	for i = 1, 64 do
		map[B64:byte(i)] = i - 1
	end
	local out, n, acc, bits = {}, 0, 0, 0
	for i = 1, #data do
		local v = map[data:byte(i)]
		if v then
			acc = bit32.bor(bit32.lshift(acc, 6), v)
			bits += 6
			if bits >= 8 then
				bits -= 8
				n += 1
				out[n] = string.char(bit32.band(bit32.rshift(acc, bits), 255))
				acc = bit32.band(acc, bit32.lshift(1, bits) - 1)
			end
		end
	end
	return table.concat(out)
end
local function loadAssets()
	if type(writefile) ~= "function" or type(getcustomasset) ~= "function" then return end
	pcall(function()
		if isfolder and not isfolder("FurinaHub") then makefolder("FurinaHub") end
		if isfolder and not isfolder("FurinaHub/assets") then makefolder("FurinaHub/assets") end
	end)
	for name, entry in pairs(ASSET_DATA) do
		local path = "FurinaHub/assets/" .. name .. "_" .. entry.v .. "." .. entry.ext
		local ok = pcall(function()
			if not (type(isfile) == "function" and isfile(path)) then writefile(path, b64decode(entry.b64)) end
		end)
		if ok then
			local ok2, id = pcall(getcustomasset, path)
			if ok2 and type(id) == "string" and id ~= "" then Assets[name] = id end
		end
	end
end

