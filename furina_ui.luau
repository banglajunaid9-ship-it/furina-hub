-- CreateWindow
------------------------------------------------------------------------------------------------------
function FurinaUI.CreateWindow(_, opts)
	if W then return W end
	opts = opts or {}
	loadSettings()
	loadAssets()
	computeTheme()
	ensureGui()
	initSounds()

	local phone = isPhone()
	local D = phone and PHONE or DESK
	local self = setmetatable({ D = D, phone = phone, tabs = {}, visible = false, quoteI = math.random(1, #QUOTES), startClock = os.clock(),
		name = opts.Name or "Furina Hub", subtitle = opts.Subtitle }, Window)
	W = self

	-- holder (moved by the drag spring) > anim (open/close motion) > shadow + window
	local holder = frame({ Name = "Holder", BackgroundTransparency = 1, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = off(D.W, D.H), Visible = false, ZIndex = 10, Parent = gui })
	self.holder = holder
	self.scale = inst("UIScale", { Parent = holder })
	local anim = frame({ BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = holder })
	self.anim = anim
	if Assets.shadow then
		image({ Image = Assets.shadow, ScaleType = Enum.ScaleType.Slice, SliceCenter = Rect.new(40, 40, 88, 88), ImageColor3 = BLACK, ImageTransparency = 0.25,
			Position = off(-34, -24), Size = U2(1, 68, 1, 68), ZIndex = 10, Parent = anim })
	end
	local win = frame({ Name = "Window", Size = UDim2.fromScale(1, 1), ClipsDescendants = true, ZIndex = 11, Parent = anim })
	self.win = win
	corner(win, 16)
	bind(win, { BackgroundColor3 = "bg2", BackgroundTransparency = "glassT" })
	bind(inst("UIGradient", { Rotation = 115, Parent = win }), { Color = "bgSeq" })
	local border = strokeOf(win, WHITE, 1.4, 0)
	local borderGrad = inst("UIGradient", { Parent = border })
	bind(borderGrad, { Color = "goldSeq" })
	borderGrad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.2, 0.85), NumberSequenceKeypoint.new(0.5, 0.05),
		NumberSequenceKeypoint.new(0.8, 0.85), NumberSequenceKeypoint.new(1, 0),
	})
	loop("win", borderGrad, TweenInfo.new(12, EQ.Linear, ED.In, -1), { Rotation = 360 })

	-- living background: soft glows drifting, bubbles rising, a shine that follows the mouse
	local deco = frame({ Name = "Deco", BackgroundTransparency = 1, Position = off(-40, -40), Size = U2(1, 80, 1, 80), ZIndex = 11, Parent = win })
	self.deco = deco
	local function blob(key, x, y, s, tr, dur, dx, dy)
		local b = soft({ Position = off(x, y), Size = off(s, s * 0.88), ImageTransparency = tr, ZIndex = 11, Parent = deco })
		if not b then return end
		bind(b, { ImageColor3 = key })
		loop("deco", b, TweenInfo.new(dur, EQ.Sine, ED.InOut, -1, true), { Position = off(x + dx, y + dy), Size = off(s * 1.2, s * 1.06) })
	end
	blob("hydro", 0, -60, 340, 0.55, 16, 70, 40)
	blob("aqua", D.W - 190, D.H * 0.32, 280, 0.7, 21, -60, 30)
	blob("gold", D.W * 0.3, D.H - 140, 260, 0.83, 25, 50, -30)
	for _ = 1, 6 do
		local s = math.random(4, 11)
		local x = math.random(8, 92) / 100
		local bub = frame({ BackgroundTransparency = 0.88, AnchorPoint = V2(0.5, 0.5), Position = U2(x, 0, 1, 20), Size = off(s, s), ZIndex = 11, Parent = deco })
		corner(bub, -1)
		bind(bub, { BackgroundColor3 = "aqua" })
		bind(strokeOf(bub, C.aqua, 1, 0.45), { Color = "aqua" })
		local dur = math.random(90, 170) / 10
		loop("deco", bub, TweenInfo.new(dur, EQ.Linear, ED.In, -1, false, math.random() * 6), { Position = U2(x + math.random(-5, 5) / 100, 0, 0, -20) })
	end
	self.glare = soft({ AnchorPoint = V2(0.5, 0.5), Size = off(560, 560), ImageColor3 = WHITE, ImageTransparency = 0.93, Visible = false, ZIndex = 30, Parent = win })

	-- gold corner ornaments
	for _, c in ipairs({ { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } }) do
		local ax, ay = c[1], c[2]
		local o = frame({ BackgroundTransparency = 1, AnchorPoint = V2(ax, ay), Position = U2(ax, ax == 0 and 4 or -4, ay, ay == 0 and 4 or -4), Size = off(16, 16), ZIndex = 35, Parent = win })
		local h = frame({ AnchorPoint = V2(ax, ay), Position = UDim2.fromScale(ax, ay), Size = off(15, 1), Parent = o, ZIndex = 35 })
		local v = frame({ AnchorPoint = V2(ax, ay), Position = UDim2.fromScale(ax, ay), Size = off(1, 15), Parent = o, ZIndex = 35 })
		local d = frame({ AnchorPoint = V2(0.5, 0.5), Position = U2(ax, ax == 0 and 5 or -5, ay, ay == 0 and 5 or -5), Size = off(3, 3), Rotation = 45, Parent = o, ZIndex = 35 })
		for _, x in ipairs({ h, v, d }) do
			bind(x, { BackgroundColor3 = "gold" })
		end
	end

	-- rail
	local rail = frame({ Name = "Rail", Size = U2(0, D.rail, 1, 0), ZIndex = 12, Parent = win })
	bind(rail, { BackgroundColor3 = "rail", BackgroundTransparency = "railT" })
	local rl = frame({ AnchorPoint = V2(1, 0), Position = UDim2.fromScale(1, 0), Size = U2(0, 1, 1, 0), ZIndex = 12, Parent = rail })
	bind(rl, { BackgroundColor3 = "line", BackgroundTransparency = "lineT" })
	if not phone then
		local logo = Assets.emblem and image({ Image = Assets.emblem, AnchorPoint = V2(0.5, 0), Position = U2(0.5, 0, 0, 12), Size = off(28, 31), ZIndex = 13, Parent = rail })
			or text({ Text = "F", TextSize = 22, FontFace = F_TITLE, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = V2(0.5, 0), Position = U2(0.5, 0, 0, 12), Size = off(28, 31), ZIndex = 13, Parent = rail })
		if logo:IsA("TextLabel") then bind(logo, { TextColor3 = "gold" }) end
		local lb = hitbox({ AnchorPoint = V2(0.5, 0), Position = U2(0.5, 0, 0, 10), Size = off(34, 36), ZIndex = 14, Parent = rail })
		lb.MouseButton1Click:Connect(function()
			sfx("pop")
			pop(logo, 0.4, { Rotation = (logo.Rotation + 360) % 720 })
			self:say(QUOTES[math.random(1, #QUOTES)], 2.2)
		end)
		if not LITE then loop("win", logo, TweenInfo.new(2, EQ.Sine, ED.InOut, -1, true), { Position = U2(0.5, 0, 0, 10) }) end
	end
	local tabsFrame = frame({ BackgroundTransparency = 1, Position = off(10, phone and 8 or 56), Size = U2(0, 34, 1, -(phone and 16 or 66)), ZIndex = 13, Parent = rail })
	self.tabsFrame = tabsFrame
	local ind = frame({ Size = off(34, 30), ZIndex = 13, Parent = tabsFrame })
	corner(ind, 10)
	ind.BackgroundColor3 = WHITE
	bind(inst("UIGradient", { Rotation = 120, Transparency = NumberSequence.new(0.6, 0.85), Parent = ind }), { Color = "accentSeq" })
	local indStroke = strokeOf(ind, C.aqua, 1, 0.5)
	bind(indStroke, { Color = "aqua" })
	loop("win", indStroke, TweenInfo.new(1.3, EQ.Sine, ED.InOut, -1, true), { Transparency = 0.15 })
	local indDia = frame({ AnchorPoint = V2(0.5, 0.5), Position = U2(0, -7, 0.5, 0), Size = off(6, 6), Rotation = 45, ZIndex = 13, Parent = ind })
	bind(indDia, { BackgroundColor3 = "gold" })
	-- liquid indicator on Y: the leading edge moves first, the trailing edge catches up
	do
		local T, B = inst("NumberValue"), inst("NumberValue")
		local function apply()
			ind.Position = off(0, T.Value)
			ind.Size = off(34, math.max(10, B.Value - T.Value))
		end
		T.Changed:Connect(apply)
		B.Changed:Connect(apply)
		self.moveInd = function(top, bot, instant)
			if instant then
				T.Value, B.Value = top, bot
				apply()
				return
			end
			local down = top > T.Value
			local fast = TweenInfo.new(0.16, EQ.Quart, ED.Out)
			local slow = TweenInfo.new(0.32, EQ.Quart, ED.Out, 0, false, 0.03)
			TweenService:Create(T, down and slow or fast, { Value = top }):Play()
			TweenService:Create(B, down and fast or slow, { Value = bot }):Play()
		end
	end

	-- header
	local main = frame({ Name = "Main", BackgroundTransparency = 1, Position = off(D.rail, 0), Size = U2(1, -D.rail, 1, 0), ZIndex = 12, Parent = win })
	local head = frame({ Name = "Header", BackgroundTransparency = 1, Size = U2(1, 0, 0, D.head), ZIndex = 12, Parent = main })
	local hl = frame({ AnchorPoint = V2(0, 1), Position = UDim2.fromScale(0, 1), Size = U2(1, 0, 0, 1), ZIndex = 12, Parent = head })
	bind(hl, { BackgroundColor3 = "line", BackgroundTransparency = "lineT" })
	self.actLabel = text({ Text = "", TextSize = 9, FontFace = F_BOLD, Position = off(16, phone and 7 or 10), Size = off(200, 12), ZIndex = 13, Parent = head })
	bind(self.actLabel, { TextColor3 = "gold" })
	self.titleBox = frame({ BackgroundTransparency = 1, Position = off(16, phone and 19 or 23), Size = off(220, 22), ZIndex = 13, Parent = head })
	inst("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder, Parent = self.titleBox })
	local function headBtn(iconName, x)
		local b = hitbox({ AnchorPoint = V2(1, 0.5), Position = U2(1, x, 0.5, 0), Size = off(28, 28), ZIndex = 14, Parent = head })
		b.BackgroundTransparency = 0
		corner(b, 9)
		bind(b, { BackgroundColor3 = "track", BackgroundTransparency = "trackT" })
		local st = strokeOf(b, C.line, 1, C.lineT)
		bind(st, { Color = "line", Transparency = "lineT" })
		local ic = icon(iconName, 13, b, "mute")
		ic.AnchorPoint = V2(0.5, 0.5)
		ic.Position = UDim2.fromScale(0.5, 0.5)
		ic.ZIndex = 15
		b.MouseEnter:Connect(function()
			tw(st, 0.15, { Color = iconName == "x" and rgb(255, 135, 150) or C.aqua, Transparency = 0.2 })
			if iconName == "x" then pop(ic, 0.25, { Rotation = 90 }) end
		end)
		b.MouseLeave:Connect(function()
			tw(st, 0.15, { Color = C.line, Transparency = C.lineT })
			pop(ic, 0.25, { Rotation = 0 })
		end)
		b.MouseButton1Down:Connect(function() pop(b, 0.2, { Size = off(25, 25) }) end)
		b.MouseButton1Up:Connect(function() pop(b, 0.25, { Size = off(28, 28) }) end)
		return b
	end
	local closeBtn = headBtn("x", -18)
	local minBtn = headBtn("minus", -52)
	closeBtn.MouseButton1Click:Connect(function()
		self:hide()
		toast(self.name, "Hidden. Press " .. (self.footKey and self.footKey.Text or S.ToggleKey) .. " or tap the drop.", 2.6)
	end)
	minBtn.MouseButton1Click:Connect(function() self:hide() end)
	-- Ousia / Pneuma pill
	local mode = hitbox({ AnchorPoint = V2(1, 0.5), Position = U2(1, -88, 0.5, 0), Size = off(52, 26), ZIndex = 14, Parent = head })
	mode.BackgroundTransparency = 0
	corner(mode, -1)
	bind(mode, { BackgroundColor3 = "track", BackgroundTransparency = "trackT" })
	bind(strokeOf(mode, C.gold, 1, 0.1), { Color = "gold" })
	local knob = frame({ AnchorPoint = V2(0, 0.5), Position = U2(0, 2, 0.5, 0), Size = off(22, 22), ZIndex = 15, Parent = mode })
	corner(knob, -1)
	inst("UIGradient", { Rotation = 45, Color = ColorSequence.new(WHITE, rgb(150, 150, 150)), Transparency = NumberSequence.new(0.55, 0), Parent = knob })
	local moon = icon("moon", 11, mode, "text")
	moon.AnchorPoint = V2(0.5, 0.5)
	moon.Position = U2(0, 13, 0.5, 0)
	moon.ZIndex = 16
	local sun = icon("sun", 11, mode, "gold")
	sun.AnchorPoint = V2(0.5, 0.5)
	sun.Position = U2(1, -13, 0.5, 0)
	sun.ZIndex = 16
	self.modeBtn, self.modeKnob = mode, knob
	mode.MouseButton1Click:Connect(function() self:setTheme(S.Theme == "Pneuma" and "Ousia" or "Pneuma") end)
	-- search
	local sbox = frame({ AnchorPoint = V2(1, 0.5), Position = U2(1, -148, 0.5, 0), Size = off(28, 28), ClipsDescendants = true, ZIndex = 14, Parent = head })
	corner(sbox, 9)
	bind(sbox, { BackgroundColor3 = "track", BackgroundTransparency = "trackT" })
	local sst = strokeOf(sbox, C.line, 1, C.lineT)
	bind(sst, { Color = "line", Transparency = "lineT" })
	local sic = icon("search", 13, sbox, "mute")
	sic.AnchorPoint = V2(0, 0.5)
	sic.Position = U2(0, 7, 0.5, 0)
	sic.ZIndex = 15
	local sinput = inst("TextBox", { BackgroundTransparency = 1, Text = "", PlaceholderText = "Search...", TextSize = 12, FontFace = F_REG, ClearTextOnFocus = false,
		TextXAlignment = Enum.TextXAlignment.Left, Position = off(28, 0), Size = U2(1, -32, 1, 0), ZIndex = 15, Parent = sbox })
	bind(sinput, { TextColor3 = "text", PlaceholderColor3 = "mute" })
	self.searchBox = sinput
	local brand
	if not phone then
		brand = text({ Text = spaced(self.name), TextSize = 9, FontFace = F_MED, TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = V2(1, 0.5),
			Position = U2(1, -184, 0.5, 0), Size = off(160, 12), ZIndex = 13, Parent = head })
		bind(brand, { TextColor3 = "mute" })
	end
	local sopen = hitbox({ Size = off(28, 28), ZIndex = 16, Parent = sbox })
	local function openSearch(open)
		tw(sbox, 0.28, { Size = off(open and 150 or 28, 28) })
		tw(sst, 0.2, { Color = open and C.aqua or C.line, Transparency = open and 0.2 or C.lineT })
		if brand then tw(brand, 0.2, { TextTransparency = open and 1 or 0 }) end
	end
	sopen.MouseButton1Click:Connect(function()
		openSearch(true)
		sinput:CaptureFocus()
		sfx("tick")
	end)
	sinput.FocusLost:Connect(function()
		if sinput.Text == "" then openSearch(false) end
	end)
	local searchToken = 0
	sinput:GetPropertyChangedSignal("Text"):Connect(function()
		searchToken += 1
		local token = searchToken
		task.delay(0.08, function()
			if token ~= searchToken then return end
			local q = sinput.Text:gsub("^%s+", ""):gsub("%s+$", "")
			self.search = q
			if q == "" then
				self.titleTab = nil
				self:showTab(self.current or self.tabs[1], false, true)
			else
				self.actLabel.Text = spaced("Search")
				self:buildPage("search", false, true)
			end
		end)
	end)

	-- body + footer
	self.body = frame({ Name = "Body", BackgroundTransparency = 1, Position = off(0, D.head), Size = U2(1, 0, 1, -(D.head + D.foot)), ClipsDescendants = true, ZIndex = 12, Parent = main })
	if D.foot > 0 then
		local foot = frame({ Name = "Footer", AnchorPoint = V2(0, 1), Position = UDim2.fromScale(0, 1), Size = U2(1, 0, 0, D.foot), ZIndex = 12, Parent = main })
		bind(foot, { BackgroundColor3 = "rail" })
		foot.BackgroundTransparency = 0.85
		local fl = frame({ Size = U2(1, 0, 0, 1), ZIndex = 12, Parent = foot })
		bind(fl, { BackgroundColor3 = "line", BackgroundTransparency = "lineT" })
		self.footChips = frame({ BackgroundTransparency = 1, Position = off(12, 4), Size = U2(1, -80, 1, -8), ZIndex = 13, Parent = foot })
		inst("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center, Parent = self.footChips })
		self.footHelp = text({ Text = "", TextSize = 11, Position = off(12, 0), Size = U2(1, -80, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Visible = false, ZIndex = 13, Parent = foot })
		bind(self.footHelp, { TextColor3 = "mute" })
		self.footKey = text({ Text = "", TextSize = 10, FontFace = F_BOLD, TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = V2(1, 0), Position = U2(1, -22, 0, 0), Size = U2(0, 60, 1, 0), ZIndex = 13, Parent = foot })
		bind(self.footKey, { TextColor3 = "gold" })
	end
	-- cover used to fade the whole window in and out
	self.cover = frame({ Name = "Cover", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 45, Parent = win })
	bind(self.cover, { BackgroundColor3 = "bg2" })

	-- speech bubble
	local bubble = text({ Text = "", TextSize = 12, FontFace = F_MED, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = rgb(19, 37, 82),
		AnchorPoint = V2(0, 1), Position = U2(0, 46, 0, -8), Size = off(160, 26), Visible = false, ZIndex = 49, Parent = anim })
	local bbg = frame({ AnchorPoint = V2(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, ZIndex = 48, Parent = bubble })
	corner(bbg, 12)
	bind(strokeOf(bbg, C.gold, 1.5, 0), { Color = "gold" })
	self.bubble, self.bubbleBg = bubble, bbg

	-- tabs: Home first, Settings last
	local home = setmetatable({ name = "Home", icon = "home", items = {}, win = self, home = true, internal = "home" }, Tab)
	self.tabs[1] = home
	self.tabs[2] = self:makeSettings()
	self.current = home
	self:buildRail()

	-- motion: one job for the drag spring, parallax and the glare; it stops itself when everything settles
	local sp = { x = 0, y = 0, vx = 0, vy = 0, tx = 0, ty = 0, px = 0, py = 0, tpx = 0, tpy = 0 }
	self.spring = sp
	local dragState = nil
	local peak = 0
	local lastDrip = 0
	self.motionJob = function(dt)
		local k = math.min(dt * 60, 3)
		if S.Calm then
			sp.x += (sp.tx - sp.x) * math.min(1, 0.3 * k)
			sp.y += (sp.ty - sp.y) * math.min(1, 0.3 * k)
			sp.vx, sp.vy = 0, 0
		else
			sp.vx += (sp.tx - sp.x) * 0.14 * k
			sp.vy += (sp.ty - sp.y) * 0.14 * k
			local damp = 0.74 ^ k
			sp.vx *= damp
			sp.vy *= damp
			sp.x += sp.vx * k
			sp.y += sp.vy * k
		end
		holder.Position = U2(0.5, sp.x, 0.5, sp.y)
		local speed = math.sqrt(sp.vx * sp.vx + sp.vy * sp.vy)
		peak = math.max(peak, speed)
		if dragState and speed > 16 and not S.Calm and not LITE and os.clock() - lastDrip > 0.12 then
			lastDrip = os.clock()
			local ap, as = win.AbsolutePosition, win.AbsoluteSize
			drip(ap.X + 20 + math.random() * (as.X - 40), ap.Y + as.Y - 4, -sp.vx * 0.05)
		end
		-- parallax layers and glare
		sp.px += (sp.tpx - sp.px) * math.min(1, 0.12 * k)
		sp.py += (sp.tpy - sp.py) * math.min(1, 0.12 * k)
		deco.Position = off(-40 + sp.px * -26, -40 + sp.py * -18)
		local settled = not dragState and math.abs(sp.tx - sp.x) < 0.1 and math.abs(sp.ty - sp.y) < 0.1 and speed < 0.05
			and math.abs(sp.tpx - sp.px) < 0.002 and math.abs(sp.tpy - sp.py) < 0.002
		if settled then
			sp.x, sp.y, sp.vx, sp.vy, sp.px, sp.py = sp.tx, sp.ty, 0, 0, sp.tpx, sp.tpy
			holder.Position = U2(0.5, sp.x, 0.5, sp.y)
		end
		return not settled
	end
	head.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		dragState = { start = input.Position, ox = sp.tx, oy = sp.ty }
		peak = 0
		self:startDrag(function(pos)
			local d = pos - dragState.start
			local sc = 1
			sp.tx = dragState.ox + d.X / sc
			sp.ty = dragState.oy + d.Y / sc
			self:wake()
		end, function()
			dragState = nil
			self:wake()
			if S.Calm then return end
			if peak > 12 then
				local s = self.baseScaleValue
				self.scale.Scale = s * 1.025
				tw(self.scale, 0.6, { Scale = s }, EQ.Elastic)
			end
			if peak > 20 and os.clock() - (self.lastQuip or 0) > 9 then
				self.lastQuip = os.clock()
				self:say(LANDINGS[math.random(1, #LANDINGS)], 1.6)
			end
		end)
		self:wake()
	end)
	win.MouseMoved:Connect(function()
		if LITE or S.Calm then return end
		local m = UserInputService:GetMouseLocation()
		local ap, as = win.AbsolutePosition, win.AbsoluteSize
		sp.tpx = (m.X - ap.X) / math.max(1, as.X) - 0.5
		sp.tpy = (m.Y - ap.Y) / math.max(1, as.Y) - 0.5
		local g = self.glare
		if g then
			g.Visible = true
			g.Position = off((m.X - ap.X) / self.scale.Scale, (m.Y - ap.Y) / self.scale.Scale)
		end
		self:wake()
	end)
	win.MouseLeave:Connect(function()
		sp.tpx, sp.tpy = 0, 0
		if self.glare then self.glare.Visible = false end
		self:wake()
	end)

	-- global input: drags, key listening, toggle key
	on(UserInputService.InputChanged, function(input)
		if self.drag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			pcall(self.drag.move, input.Position)
		end
	end)
	on(UserInputService.InputEnded, function(input)
		if self.drag and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			local d = self.drag
			self.drag = nil
			if d.done then pcall(d.done) end
		end
	end)
	on(UserInputService.InputBegan, function(input, processed)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
		if self.keyListener then
			local fn = self.keyListener
			self.keyListener = nil
			fn(input.KeyCode)
			return
		end
		if processed or UserInputService:GetFocusedTextBox() then return end
		if input.KeyCode.Name == S.ToggleKey and not self.loader then self:toggle() end
	end)
	on(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"), function() self:applyScale(false) end)

	-- once a second: FPS history and the Home stats
	task.spawn(function()
		while alive and W == self do
			task.wait(1)
			fpsValue = frameCount
			frameCount = 0
			table.insert(fpsHist, fpsValue)
			if #fpsHist > 20 then table.remove(fpsHist, 1) end
			if self.visible and self.current and self.current.home and (self.search or "") == "" then
				self:startFps()
				self:tickHome()
			else
				self:stopFps()
			end
		end
	end)
	task.spawn(function()
		while alive and W == self do
			task.wait(6)
			if self.visible and self.homeQuote and self.homeQuote.Parent and self.current and self.current.home then
				self.quoteI += 1
				local q = self.homeQuote
				tw(q, 0.25, { TextTransparency = 1 })
				task.delay(0.26, function()
					if q.Parent then
						q.Text = "“" .. QUOTES[self.quoteI % #QUOTES + 1] .. "”"
						tw(q, 0.3, { TextTransparency = 0 })
					end
				end)
			end
		end
	end)

	self:applyScale(false)
	self:paintMode(false)
	self:paintKey()
	self:renderFoot()
	self:buildFab()
	self:buildLoader(self.subtitle)
	self:loaderStep("Loading your settings", 18)
	self:loaderStep("Waking the tide", 26)
	if S.Perf == "Lite" then self:setLite(true) end
	return self
end

-- Luna's Window also had these; keep them harmless
function Window:SelectTab(tab) if tab then self:showTab(tab, true) end end
function Window:Notify(o) FurinaUI:Notification(o) end

------------------------------------------------------------------------------------------------------
-- library functions
------------------------------------------------------------------------------------------------------
function FurinaUI:Notification(o)
	o = o or {}
	toast(o.Title, o.Content or o.Text, o.Duration or 3)
end
FurinaUI.Notify = FurinaUI.Notification

function FurinaUI:Destroy()
	alive = false
	for _, c in ipairs(conns) do
		pcall(function() c:Disconnect() end)
	end
	table.clear(conns)
	if hb then
		hb:Disconnect()
		hb = nil
	end
	table.clear(jobs)
	for g in pairs(loops) do
		setLoops(g, false)
	end
	table.clear(loops)
	if W then
		W:stopFps()
		if W.loader and W.loader.keyConn then W.loader.keyConn:Disconnect() end
	end
	if gui then gui:Destroy() end
	gui, W = nil, nil
	genv.FurinaUI_Unload = nil
end
genv.FurinaUI_Unload = function() FurinaUI:Destroy() end

function FurinaUI:SetTheme(name) if W then W:setTheme(name) end end
function FurinaUI:Toggle() if W then W:toggle() end end

return FurinaUI
