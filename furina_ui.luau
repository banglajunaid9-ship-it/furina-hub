function Window:makeSettings()
	local tab = setmetatable({ name = "Settings", icon = "gear", items = {}, win = self, internal = "settings" }, Tab)
	local win = self
	tab:CreateSection("Look")
	local theme = tab:CreateDropdown({ Name = "Theme", Description = "Ousia is dark, Pneuma is light", Options = { "Ousia", "Pneuma" }, CurrentOption = { S.Theme },
		Callback = function(v) win:setTheme(v) end })
	tab:CreateButton({ Name = "Accent: " .. S.Accent, Description = "Cycle the main colour: Hydro, Gold, Teal, Rose, Violet", Callback = function()
		local i = table.find(ACCENT_ORDER, S.Accent) or 1
		S.Accent = ACCENT_ORDER[i % #ACCENT_ORDER + 1]
		saveSettings()
		computeTheme()
		applyTheme()
		win:showTab(win.current, false, true)
		toast("Accent", S.Accent, 1.6)
	end })
	local scale = tab:CreateSlider({ Name = "UI Scale", Description = "Size of the menu (applies when you let go)", Range = { 80, 120 }, Increment = 5, Suffix = "%", CurrentValue = S.Scale,
		Callback = function() end, OnRelease = function(v)
			S.Scale = v
			saveSettings()
			win:applyScale(true)
		end })
	local glass = tab:CreateSlider({ Name = "Transparency", Description = "See the game through the menu", Range = { 0, 60 }, Increment = 5, Suffix = "%", CurrentValue = S.Glass,
		Callback = function(v)
			S.Glass = v
			saveSettings()
			computeTheme()
			win.win.BackgroundTransparency = C.glassT
		end })
	tab:CreateSection("Behavior")
	local key = tab:CreateBind({ Name = "Toggle Key", Description = "Shows or hides the menu", CurrentBind = S.ToggleKey, OnChangedCallback = function(kc)
		S.ToggleKey = kc.Name
		saveSettings()
		win:paintKey()
	end })
	local notify = tab:CreateToggle({ Name = "Notifications", Description = "Pop-up messages in the corner", CurrentValue = S.Notify, Callback = function(v)
		S.Notify = v
		saveSettings()
	end })
	local calm = tab:CreateToggle({ Name = "Calm Motion", Description = "No bounce, drips or splashes", CurrentValue = S.Calm, Callback = function(v)
		S.Calm = v
		saveSettings()
	end })
	local perf = tab:CreateDropdown({ Name = "Performance", Description = "Auto switches to Lite only if this device cannot keep up", Options = { "Auto", "Full", "Lite" },
		CurrentOption = { S.Perf }, Callback = function(v)
			S.Perf = v
			saveSettings()
			win:applyPerf()
		end })
	tab:CreateSection("Sound")
	local snd = tab:CreateToggle({ Name = "Sounds", Description = "Soft water clicks when you tap things", CurrentValue = S.Sound, Callback = function(v)
		S.Sound = v
		saveSettings()
	end })
	local vol = tab:CreateSlider({ Name = "Volume", Range = { 0, 100 }, Increment = 5, Suffix = "%", CurrentValue = S.Volume, Callback = function(v)
		S.Volume = v
		saveSettings()
	end, OnRelease = function() sfx("ok") end })
	tab:CreateSection("Furina")
	local quotes = tab:CreateToggle({ Name = "Furina Quotes", Description = "Lines on load, logo tap and after a fling", CurrentValue = S.Quotes, Callback = function(v)
		S.Quotes = v
		saveSettings()
	end })
	tab:CreateSection("Reset")
	tab:CreateButton({ Name = "Reset Position", Description = "Move the window back to the middle", Callback = function()
		win.spring.tx, win.spring.ty = 0, 0
		win:wake()
	end })
	tab:CreateButton({ Name = "Reset UI Settings", Description = "Default look, toggle key and sounds", Danger = true, Callback = function()
		local pins = S.Pins
		resetSettings()
		S.Pins = pins
		saveSettings()
		win:setTheme(S.Theme, true)
		win:applyScale(true)
		win:applyPerf()
		win:paintKey()
		toast("Settings", "Back to defaults.", 2)
	end })
	self.settingsHandles = { theme = theme, scale = scale, glass = glass, key = key, notify = notify, calm = calm, perf = perf, snd = snd, vol = vol, quotes = quotes }
	return tab
end
function Window:syncSettings()
	local h = self.settingsHandles
	if not h then return end
	h.theme.Item.value = S.Theme
	h.scale.Item.value = S.Scale
	h.glass.Item.value = S.Glass
	h.key.Item.value = S.ToggleKey
	h.notify.Item.value = S.Notify
	h.calm.Item.value = S.Calm
	h.perf.Item.value = S.Perf
	h.snd.Item.value = S.Sound
	h.vol.Item.value = S.Volume
	h.quotes.Item.value = S.Quotes
	for _, it in ipairs(self.tabs[#self.tabs].items) do
		if it.kind == "button" and it.name:sub(1, 7) == "Accent:" then it.name = "Accent: " .. S.Accent end
	end
end

------------------------------------------------------------------------------------------------------
-- theme switch with a wave of the new colour, scale, performance
------------------------------------------------------------------------------------------------------
function Window:setTheme(name, instant)
	if name ~= "Ousia" and name ~= "Pneuma" then return end
	local changed = S.Theme ~= name
	S.Theme = name
	saveSettings()
	local function apply()
		computeTheme()
		applyTheme()
		self.win.BackgroundTransparency = C.glassT
		self:paintMode(true)
		if self.current and self.current.internal == "settings" then self:showTab(self.current, false, true) end
	end
	if instant or not changed then
		apply()
		return
	end
	sfx("pop")
	local m = self.modeBtn
	local sc = self.scale.Scale
	local cx = (m.AbsolutePosition.X + m.AbsoluteSize.X / 2 - self.win.AbsolutePosition.X) / sc
	local cy = (m.AbsolutePosition.Y + m.AbsoluteSize.Y / 2 - self.win.AbsolutePosition.Y) / sc
	local wave = frame({ AnchorPoint = V2(0.5, 0.5), Position = off(cx, cy), Size = off(0, 0), BackgroundColor3 = (name == "Pneuma") and THEMES.Pneuma.bg2 or THEMES.Ousia.bg2, ZIndex = 40, Parent = self.win })
	corner(wave, -1)
	local diag = math.sqrt(self.D.W ^ 2 + self.D.H ^ 2) * 2.1
	tw(wave, 0.42, { Size = off(diag, diag) }, EQ.Quad, ED.InOut)
	for k = 0, 2 do
		local ring = frame({ BackgroundTransparency = 1, AnchorPoint = V2(0.5, 0.5), Position = off(cx, cy), Size = off(16, 16), ZIndex = 41, Parent = self.win })
		corner(ring, -1)
		local st = strokeOf(ring, name == "Pneuma" and ACCENTS.Hydro[3] or ACCENTS.Hydro[2], 1.5, 0.1)
		tw(ring, 0.7, { Size = off(500, 500) }, EQ.Quint, ED.Out, k * 0.1)
		tw(st, 0.7, { Transparency = 1 }, EQ.Quint, ED.Out, k * 0.1)
		task.delay(1, function() ring:Destroy() end)
	end
	task.delay(0.42, function()
		apply()
		tw(wave, 0.22, { BackgroundTransparency = 1 })
		task.delay(0.24, function() wave:Destroy() end)
	end)
end

function Window:paintMode(anim)
	local light = S.Theme == "Pneuma"
	local x = light and 28 or 2
	if anim then pop(self.modeKnob, 0.3, { Position = U2(0, x, 0.5, 0) }) else self.modeKnob.Position = U2(0, x, 0.5, 0) end
	self.modeKnob.BackgroundColor3 = light and rgb(240, 214, 150) or rgb(50, 98, 196)
end

function Window:applyScale(anim)
	local s = baseScale(self.D) * (S.Scale / 100)
	self.baseScaleValue = s
	if anim then tw(self.scale, 0.35, { Scale = s }, EQ.Back) else self.scale.Scale = s end
	if self.fabScale then self.fabScale.Scale = math.clamp(s, 0.8, 1.2) end
end

function Window:setLite(on_)
	LITE = on_ and true or false
	if self.deco then self.deco.Visible = not LITE end
	if self.glare then self.glare.Visible = false end
	setLoops("deco", self.visible and not LITE)
end
function Window:applyPerf()
	if S.Perf == "Lite" then
		self:setLite(true)
		return
	end
	self:setLite(false)
	if S.Perf ~= "Auto" or self.probing then return end
	-- measure the real frame rate for 2 seconds; under 28 FPS gets Lite and a notice
	self.probing = true
	local frames, t0 = 0, os.clock()
	local c
	c = RunService.RenderStepped:Connect(function()
		frames += 1
		if os.clock() - t0 >= 2 then
			c:Disconnect()
			self.probing = false
			local fps = frames / (os.clock() - t0)
			if S.Perf == "Auto" and fps < 28 and not LITE then
				self:setLite(true)
				toast("Lite mode", string.format("This device ran at %d FPS, so heavy effects are trimmed. Change it in Settings > Performance.", math.floor(fps)), 4.5, true)
			end
		end
	end)
	conns[#conns + 1] = c
end

function Window:paintKey()
	local short = ({ RightShift = "RShift", LeftShift = "LShift", RightControl = "RCtrl", LeftControl = "LCtrl", Insert = "Ins", Delete = "Del" })[S.ToggleKey] or S.ToggleKey
	if self.footKey then self.footKey.Text = short end
	if self.fabKey then self.fabKey.Text = short end
end

------------------------------------------------------------------------------------------------------
-- speech bubble
------------------------------------------------------------------------------------------------------
function Window:say(msg, dur)
	if not S.Quotes or not self.bubble then return end
	local b = self.bubble
	b.Text = msg
	b.Size = off(textWidth(msg, 12) + 24, 26)
	b.Visible = true
	b.TextTransparency = 0
	self.bubbleBg.BackgroundTransparency = 0
	self.bubbleBg.Size = UDim2.fromScale(0.6, 0.6)
	pop(self.bubbleBg, 0.3, { Size = UDim2.fromScale(1, 1) })
	self.sayToken = (self.sayToken or 0) + 1
	local token = self.sayToken
	task.delay(dur or 1.6, function()
		if token ~= self.sayToken then return end
		tw(b, 0.2, { TextTransparency = 1 })
		tw(self.bubbleBg, 0.2, { BackgroundTransparency = 1 })
		task.delay(0.2, function()
			if token == self.sayToken then b.Visible = false end
		end)
	end)
end

------------------------------------------------------------------------------------------------------
-- show / hide
------------------------------------------------------------------------------------------------------
function Window:wake() runJob(self.motionJob) end

function Window:show(quiet)
	if self.visible then return end
	self.visible = true
	self.holder.Visible = true
	local s = self.baseScaleValue
	self.scale.Scale = s * 0.92
	self.anim.Position = off(0, 30)
	self.cover.BackgroundTransparency = 0
	pop(self.scale, 0.5, { Scale = s })
	pop(self.anim, 0.5, { Position = off(0, 0) })
	tw(self.cover, 0.4, { BackgroundTransparency = 1 })
	setLoops("win", true)
	setLoops("deco", not LITE)
	self:hideFab()
	if not quiet then sfx("open") end
	self:showTab(self.current or self.tabs[1], true)
	if self.current and self.current.home then self:startFps() end
end

function Window:hide()
	if not self.visible then return end
	self.visible = false
	local s = self.baseScaleValue
	tw(self.scale, 0.3, { Scale = s * 0.9 }, EQ.Quint, ED.In)
	tw(self.anim, 0.3, { Position = off(0, 34) }, EQ.Quint, ED.In)
	tw(self.cover, 0.26, { BackgroundTransparency = 0 })
	sfx("close")
	popLayer.Visible = false
	task.delay(0.31, function()
		if not self.visible then
			self.holder.Visible = false
			setLoops("win", false)
			setLoops("deco", false)
			setLoops("page", false)
		end
	end)
	self:showFab()
end
function Window:toggle()
	if self.visible then self:hide() else self:show() end
end

function Window:startFps()
	if self.fpsConn then return end
	self.fpsConn = RunService.RenderStepped:Connect(function() frameCount += 1 end)
end
function Window:stopFps()
	if self.fpsConn then
		self.fpsConn:Disconnect()
		self.fpsConn = nil
	end
end

------------------------------------------------------------------------------------------------------
-- launcher: a glass orb with water inside, a turning gold ring and ripples; drag it anywhere
------------------------------------------------------------------------------------------------------
function Window:buildFab()
	local fab = frame({ Name = "Launcher", BackgroundTransparency = 1, AnchorPoint = V2(0, 1), Position = U2(0, 20, 1, -20), Size = off(58, 58), Visible = false, ZIndex = 40, Parent = gui })
	self.fabScale = inst("UIScale", { Parent = fab })
	local pulses = {}
	for i = 1, 2 do
		local p = frame({ BackgroundTransparency = 1, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = off(58, 58), ZIndex = 40, Parent = fab })
		corner(p, -1)
		local st = strokeOf(p, i == 1 and C.aqua or C.gold, 1.5, 0.25)
		bind(st, { Color = i == 1 and "aqua" or "gold" })
		pulses[i] = { p = p, st = st }
		loop("fab", p, TweenInfo.new(2.8, EQ.Quint, ED.Out, -1, false, (i - 1) * 1.4), { Size = off(100, 100) })
		loop("fab", st, TweenInfo.new(2.8, EQ.Quint, ED.Out, -1, false, (i - 1) * 1.4), { Transparency = 1 })
	end
	local body = frame({ BackgroundTransparency = 1, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), ZIndex = 41, Parent = fab })
	local bodyScale = inst("UIScale", { Parent = body })
	-- orb with moving water (CanvasGroup clips the water to the circle)
	local orb = inst("CanvasGroup", { BackgroundColor3 = rgb(11, 24, 56), BorderSizePixel = 0, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = off(52, 52), ZIndex = 41, Parent = body })
	corner(orb, -1)
	inst("UIGradient", { Rotation = 60, Color = ColorSequence.new(rgb(34, 72, 154), rgb(11, 24, 56)), Parent = orb })
	local water = frame({ BackgroundTransparency = 1, Position = off(0, 30), Size = off(52, 52), ZIndex = 42, Parent = orb })
	if Assets.wave then
		local w1 = image({ Image = Assets.wave, ScaleType = Enum.ScaleType.Tile, TileSize = off(52, 52), Size = off(104, 52), ZIndex = 42, Parent = water })
		bind(w1, { ImageColor3 = "hydro" })
		w1.ImageTransparency = 0.25
		local w2 = image({ Image = Assets.wave, ScaleType = Enum.ScaleType.Tile, TileSize = off(52, 52), Position = off(-52, 4), Size = off(104, 52), ZIndex = 43, Parent = water })
		bind(w2, { ImageColor3 = "aqua" })
		w2.ImageTransparency = 0.5
		loop("fab", w1, TweenInfo.new(3.2, EQ.Linear, ED.In, -1), { Position = off(-52, 0) })
		loop("fab", w2, TweenInfo.new(4.8, EQ.Linear, ED.In, -1), { Position = off(0, 4) })
	else
		local fill = frame({ Size = UDim2.fromScale(1, 1), ZIndex = 42, Parent = water })
		bind(fill, { BackgroundColor3 = "hydro" })
		fill.BackgroundTransparency = 0.3
	end
	local shine = frame({ Position = off(11, 6), Size = off(18, 8), Rotation = -20, BackgroundColor3 = WHITE, BackgroundTransparency = 0.72, ZIndex = 45, Parent = orb })
	corner(shine, -1)
	local ring = frame({ BackgroundTransparency = 1, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = off(54, 54), ZIndex = 46, Parent = body })
	corner(ring, -1)
	local rs = strokeOf(ring, WHITE, 2.4, 0)
	local rg = inst("UIGradient", { Parent = rs })
	bind(rg, { Color = function(c) return ColorSequence.new({ ColorSequenceKeypoint.new(0, c.gold), ColorSequenceKeypoint.new(0.3, rgb(255, 244, 207)),
		ColorSequenceKeypoint.new(0.55, c.aqua), ColorSequenceKeypoint.new(0.8, rgb(154, 113, 38)), ColorSequenceKeypoint.new(1, c.gold) }) end })
	loop("fab", rg, TweenInfo.new(7, EQ.Linear, ED.In, -1), { Rotation = 360 })
	local emb
	if Assets.emblem then
		emb = image({ Image = Assets.emblem, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = off(27, 30), ZIndex = 47, Parent = body })
	else
		emb = text({ Text = "F", TextSize = 22, FontFace = F_TITLE, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = off(30, 30), ZIndex = 47, Parent = body })
		bind(emb, { TextColor3 = "gold" })
	end
	-- tooltip
	local tip = frame({ AnchorPoint = V2(0, 0.5), Position = U2(1, 12, 0.5, 0), Size = off(170, 26), Visible = false, ZIndex = 48, Parent = fab })
	corner(tip, 9)
	tip.BackgroundColor3 = rgb(13, 26, 61)
	tip.BackgroundTransparency = 0.04
	strokeOf(tip, rgb(143, 220, 255), 1, 0.7)
	text({ Text = 'Open <font color="#e2be78"><b>Furina Hub</b></font>', RichText = true, TextSize = 12, TextColor3 = rgb(238, 244, 255), Position = off(10, 0), Size = U2(1, -60, 1, 0), ZIndex = 49, Parent = tip })
	local kc = frame({ AnchorPoint = V2(1, 0.5), Position = U2(1, -8, 0.5, 0), Size = off(44, 16), BackgroundColor3 = WHITE, BackgroundTransparency = 0.88, ZIndex = 49, Parent = tip })
	corner(kc, 4)
	self.fabKey = text({ Text = "RShift", TextSize = 10, TextColor3 = rgb(207, 224, 255), TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), ZIndex = 50, Parent = kc })
	local btn = hitbox({ Size = UDim2.fromScale(1, 1), ZIndex = 52, Parent = fab })
	btn.MouseEnter:Connect(function()
		if not self.phone then tip.Visible = true end
		pop(emb, 0.3, { Rotation = -8, Size = off(30, 33) })
		tw(water, 0.5, { Position = off(0, 20) }, EQ.Back)
	end)
	btn.MouseLeave:Connect(function()
		tip.Visible = false
		pop(emb, 0.3, { Rotation = 0, Size = off(27, 30) })
		tw(water, 0.5, { Position = off(0, 30) }, EQ.Back)
	end)
	-- drag anywhere, snap to the nearest side; a tap opens the menu
	local moved, start, startPos = false, nil, nil
	btn.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		moved, start, startPos = false, input.Position, fab.AbsolutePosition
		tw(bodyScale, 0.12, { Scale = 0.9 })
		self:startDrag(function(pos)
			local d = pos - start
			if not moved and d.Magnitude < 6 then return end
			moved = true
			tip.Visible = false
			local vs = gui.AbsoluteSize
			fab.AnchorPoint = V2(0, 0)
			fab.Position = off(math.clamp(startPos.X + d.X, 6, vs.X - 64), math.clamp(startPos.Y + d.Y, 6, vs.Y - 64))
		end, function()
			pop(bodyScale, 0.3, { Scale = 1 })
			if moved then
				local vs = gui.AbsoluteSize
				local right = fab.AbsolutePosition.X + 29 > vs.X / 2
				tip.AnchorPoint = right and V2(1, 0.5) or V2(0, 0.5)
				tip.Position = right and U2(0, -12, 0.5, 0) or U2(1, 12, 0.5, 0)
				pop(fab, 0.45, { Position = off(right and (vs.X - 74) or 16, fab.Position.Y.Offset) })
				sfx("tick")
			else
				splash(fab, { C.aqua, C.gold, WHITE }, 10)
				self:show()
			end
		end)
	end)
	self.fab = fab
	self.fabBody = body
end
function Window:showFab()
	local f = self.fab
	if not f then return end
	f.Visible = true
	self.fabBody.Position = U2(0.5, 0, 0.5, 20)
	self.fabBody.Size = UDim2.fromScale(0.6, 0.6)
	pop(self.fabBody, 0.4, { Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1) })
	setLoops("fab", true)
end
function Window:hideFab()
	if not self.fab then return end
	self.fab.Visible = false
	setLoops("fab", false)
end

