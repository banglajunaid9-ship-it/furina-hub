-- loading screen: drop, ripples, title rising out of the water, then a loader that fills
------------------------------------------------------------------------------------------------------
local LOAD_STEPS = { "Raising the curtain", "Loading your settings", "Waking the tide" }
function Window:buildLoader(subtitle)
	local L = {}
	local root = frame({ Name = "Loader", Size = UDim2.fromScale(1, 1), BackgroundColor3 = rgb(8, 17, 40), BackgroundTransparency = 0.06, ZIndex = 80, Parent = gui })
	inst("UIGradient", { Rotation = 90, Color = ColorSequence.new(rgb(22, 44, 100), rgb(4, 9, 22)), Parent = root })
	local lineY = 0.44
	local line = frame({ AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, lineY), Size = off(0, 1), BackgroundColor3 = rgb(143, 220, 255), ZIndex = 81, Parent = root })
	inst("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.35), NumberSequenceKeypoint.new(1, 1) }), Parent = line })
	local drop = frame({ AnchorPoint = V2(0.5, 1), Position = U2(0.5, 0, 0, -30), Size = off(14, 19), BackgroundColor3 = rgb(143, 220, 255), ZIndex = 82, Parent = root })
	corner(drop, -1)
	inst("UIGradient", { Rotation = 90, Color = ColorSequence.new(WHITE, rgb(59, 134, 232)), Parent = drop })
	-- title letters and their reflection
	local word = "FURINA"
	local letters, refl = {}, {}
	local size, step = 46, 46
	local startX = -(#word - 1) * step / 2
	for i = 1, #word do
		local ch = word:sub(i, i)
		local l = text({ Text = ch, TextSize = size, FontFace = F_TITLE, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = V2(0.5, 1),
			Position = U2(0.5, startX + (i - 1) * step, lineY, 22), Size = off(step, 56), TextColor3 = WHITE, TextTransparency = 1, ZIndex = 83, Parent = root })
		inst("UIGradient", { Rotation = 90, Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, WHITE), ColorSequenceKeypoint.new(0.6, rgb(207, 233, 255)), ColorSequenceKeypoint.new(1, rgb(220, 184, 113)) }), Parent = l })
		letters[i] = l
		local r = text({ Text = ch, TextSize = size, FontFace = F_TITLE, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = V2(0.5, 0),
			Position = U2(0.5, startX + (i - 1) * step, lineY, 2), Size = off(step, 56), Rotation = 180, TextColor3 = rgb(160, 200, 255), TextTransparency = 1, ZIndex = 82, Parent = root })
		inst("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0.35, 1), Parent = r })
		refl[i] = r
	end
	local sub = text({ Text = spaced(subtitle or "Hydro Interface"), TextSize = 11, FontFace = F_BOLD, TextColor3 = rgb(220, 184, 113), TextTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = V2(0.5, 0), Position = U2(0.5, 0, lineY, 64), Size = off(400, 14), ZIndex = 83, Parent = root })
	-- loader row
	local box = frame({ BackgroundTransparency = 1, AnchorPoint = V2(0.5, 0), Position = U2(0.5, 0, lineY, 96), Size = off(270, 60), ZIndex = 83, Parent = root })
	local dropIcon
	if Assets.emblem then dropIcon = image({ Image = Assets.emblem, Size = off(16, 18), ImageTransparency = 1, ZIndex = 84, Parent = box }) end
	local status = text({ Text = LOAD_STEPS[1] .. "…", TextSize = 12, TextColor3 = rgb(185, 201, 232), TextTransparency = 1, Position = off(24, 0), Size = U2(1, -70, 0, 18), ZIndex = 84, Parent = box })
	local pct = text({ Text = "0%", TextSize = 12, FontFace = F_BOLD, TextColor3 = rgb(143, 220, 255), TextTransparency = 1, TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = V2(1, 0), Position = UDim2.fromScale(1, 0), Size = off(44, 18), ZIndex = 84, Parent = box })
	local bar = frame({ Position = off(0, 28), Size = U2(1, 0, 0, 4), BackgroundColor3 = WHITE, BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 84, Parent = box })
	corner(bar, -1)
	local fill = frame({ Size = UDim2.fromScale(0, 1), BackgroundColor3 = WHITE, ZIndex = 85, Parent = bar })
	corner(fill, -1)
	local fillGrad = inst("UIGradient", { Color = ColorSequence.new(rgb(47, 125, 225), rgb(143, 220, 255)), Parent = fill })
	local shimmer = frame({ Size = U2(0, 60, 1, 0), Position = off(-60, 0), BackgroundColor3 = WHITE, ZIndex = 86, Parent = bar })
	inst("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.45), NumberSequenceKeypoint.new(1, 1) }), Parent = shimmer })
	loop("loader", shimmer, TweenInfo.new(1.3, EQ.Linear, ED.In, -1), { Position = off(280, 0) })
	local skipL = text({ Text = spaced("Tap or press any key to skip"), TextSize = 9, TextColor3 = rgb(185, 201, 232), TextTransparency = 1, TextXAlignment = Enum.TextXAlignment.Center,
		Position = off(0, 44), Size = U2(1, 0, 0, 12), ZIndex = 84, Parent = box })

	-- timeline
	tw(drop, 0.6, { Position = U2(0.5, 0, lineY, 0) }, EQ.Quad, ED.In, 0.1)
	task.delay(0.7, function()
		drop:Destroy()
		tw(line, 1.4, { Size = U2(0.7, 0, 0, 1) })
		for k = 0, 2 do
			local ring = frame({ BackgroundTransparency = 1, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, lineY), Size = off(20, 6), ZIndex = 81, Parent = root })
			corner(ring, -1)
			local st = strokeOf(ring, k == 1 and rgb(220, 184, 113) or rgb(143, 220, 255), 1.5, 0.1)
			tw(ring, 1.6, { Size = off(420, 118) }, EQ.Quint, ED.Out, k * 0.16)
			tw(st, 1.6, { Transparency = 1 }, EQ.Quint, ED.Out, k * 0.16)
			task.delay(2, function() ring:Destroy() end)
		end
		sfx("pop")
	end)
	for i, l in ipairs(letters) do
		local d = 0.9 + (i - 1) * 0.05
		local target = l.Position
		l.Position = target + off(0, 26)
		pop(l, 0.9, { Position = target }, d)
		tw(l, 0.7, { TextTransparency = 0 }, EQ.Quint, ED.Out, d)
		tw(refl[i], 0.9, { TextTransparency = 0.55 }, EQ.Quint, ED.Out, d + 0.1)
	end
	tw(sub, 0.7, { TextTransparency = 0 }, EQ.Quint, ED.Out, 1.3)
	for _, o in ipairs({ status, pct, skipL }) do
		tw(o, 0.5, { TextTransparency = o == skipL and 0.55 or 0 }, EQ.Quint, ED.Out, 1.2)
	end
	if dropIcon then tw(dropIcon, 0.5, { ImageTransparency = 0 }, EQ.Quint, ED.Out, 1.2) end
	tw(bar, 0.5, { BackgroundTransparency = 0.9 }, EQ.Quint, ED.Out, 1.2)

	L.root, L.fill, L.fillGrad, L.status, L.pct, L.dropIcon = root, fill, fillGrad, status, pct, dropIcon
	L.shown, L.target, L.minDone, L.done, L.skip = 0, 12, false, false, false
	task.delay(1.2, function() L.minDone = true end)
	-- skip with any key or tap
	local skipBtn = hitbox({ Size = UDim2.fromScale(1, 1), ZIndex = 90, Parent = root })
	skipBtn.MouseButton1Click:Connect(function() L.skip = true end)
	L.keyConn = UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Keyboard then L.skip = true end
	end)
	self.loader = L
	runJob(function(dt) return self:loaderTick(dt) end)
end

function Window:loaderStep(msg, target)
	local L = self.loader
	if not L or L.done then return end
	L.steps = L.steps or {}
	table.insert(L.steps, msg)
	L.target = math.min(target or (L.target + 9), 92)
	L.lastStep = os.clock()
end

function Window:loaderTick(dt)
	local L = self.loader
	if not L or not L.root.Parent then return false end
	if not L.minDone then return true end
	if L.ready and L.target < 100 then L.target = 100 end
	-- auto-finish if the script never calls Ready()
	if not L.ready and L.lastStep and os.clock() - L.lastStep > 2.5 then
		L.ready = true
		L.target = 100
	end
	local speed = (L.skip and 9 or 1) * (S.Calm and 2 or 1)
	local rate = (L.target - L.shown) * math.min(1, dt * 3.2 * speed) + dt * 22 * speed
	L.shown = math.min(L.target, L.shown + rate)
	local v = L.shown
	L.fill.Size = UDim2.fromScale(v / 100, 1)
	L.pct.Text = math.floor(v) .. "%"
	local steps = L.steps or {}
	if not L.all or L.allN ~= #steps then
		L.all = table.clone(LOAD_STEPS)
		for _, s in ipairs(steps) do
			L.all[#L.all + 1] = s
		end
		L.all[#L.all + 1] = "Setting the stage"
		L.allN = #steps
	end
	local all = L.all
	local idx = math.clamp(math.floor(v / 100 * #all) + 1, 1, #all)
	local msg = all[idx] .. "…"
	if L.status.Text ~= msg and v < 100 then L.status.Text = msg end
	if v >= 100 and not L.done then
		L.done = true
		L.status.Text = "Curtain up!"
		L.status.TextColor3 = rgb(220, 184, 113)
		L.pct.TextColor3 = rgb(220, 184, 113)
		L.fillGrad.Color = ColorSequence.new(rgb(220, 184, 113), rgb(255, 244, 207))
		if L.dropIcon then
			pop(L.dropIcon, 0.25, { Size = off(24, 27), Position = off(-4, -4), Rotation = -12 })
			task.delay(0.25, function() pop(L.dropIcon, 0.3, { Size = off(16, 18), Position = off(0, 0), Rotation = 0 }) end)
		end
		sfx("ok")
		if L.keyConn then L.keyConn:Disconnect() end
		task.delay(0.42, function()
			for _, d in ipairs(L.root:GetDescendants()) do
				if d:IsA("TextLabel") then tw(d, 0.4, { TextTransparency = 1 })
				elseif d:IsA("ImageLabel") then tw(d, 0.4, { ImageTransparency = 1 })
				elseif d:IsA("Frame") and d.BackgroundTransparency < 1 then tw(d, 0.4, { BackgroundTransparency = 1 }) end
			end
			tw(L.root, 0.5, { BackgroundTransparency = 1 })
			self:show(true)
			task.delay(0.6, function()
				L.root:Destroy()
				setLoops("loader", false)
				self.loader = nil
				self:say(math.random() < 0.5 and "Welcome back~" or "The stage is set. Shall we begin?", 2)
				self:applyPerf()
			end)
		end)
		return false
	end
	return true
end

function Window:Ready()
	if self.loader then
		self.loader.ready = true
	elseif not self.visible then
		self:show()
	end
end

