function Window:openPicker(anchor, it)
	popLayer:ClearAllChildren()
	popLayer.Visible = true
	local closer = hitbox({ Size = UDim2.fromScale(1, 1), Parent = popLayer })
	closer.MouseButton1Click:Connect(function()
		popLayer.Visible = false
		popLayer:ClearAllChildren()
	end)
	local sc = self.scale.Scale
	local p = frame({ Size = off(196 * sc, 168 * sc), Parent = popLayer })
	local ap, as = anchor.AbsolutePosition, anchor.AbsoluteSize
	local vs = popLayer.AbsoluteSize
	p.Position = off(math.clamp(ap.X + as.X - 196 * sc, 8, vs.X - 204 * sc), math.clamp(ap.Y + as.Y + 6, 8, vs.Y - 176 * sc))
	inst("UIScale", { Scale = sc, Parent = p })
	p.Size = off(196, 168)
	corner(p, 12)
	bind(p, { BackgroundColor3 = "panel2" })
	bind(strokeOf(p, C.aqua, 1, 0.3), { Color = "aqua" })
	local h, s, v = it.value:ToHSV()
	local sv = frame({ Position = off(10, 10), Size = off(176, 100), Parent = p })
	corner(sv, 7)
	local white = frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, Parent = sv })
	corner(white, 7)
	inst("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = white })
	local black = frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK, Parent = sv })
	corner(black, 7)
	inst("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0), Parent = black })
	local svKnob = frame({ AnchorPoint = V2(0.5, 0.5), Size = off(12, 12), BackgroundTransparency = 1, ZIndex = 3, Parent = sv })
	corner(svKnob, -1)
	strokeOf(svKnob, WHITE, 2, 0)
	local hue = frame({ Position = off(10, 118), Size = off(176, 12), BackgroundColor3 = WHITE, Parent = p })
	corner(hue, 6)
	local keys = {}
	for i = 0, 6 do
		keys[#keys + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV((i / 6) % 1, 1, 1))
	end
	inst("UIGradient", { Color = ColorSequence.new(keys), Parent = hue })
	local hueKnob = frame({ AnchorPoint = V2(0.5, 0.5), Size = off(6, 16), BackgroundColor3 = WHITE, ZIndex = 3, Parent = hue })
	corner(hueKnob, 3)
	local function paint(fire)
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svKnob.Position = UDim2.fromScale(s, 1 - v)
		hueKnob.Position = UDim2.fromScale(h, 0.5)
		if fire then it:set(Color3.fromHSV(h, s, v), true) end
	end
	paint(false)
	local function dragOn(target, fn)
		local b = hitbox({ Size = UDim2.fromScale(1, 1), ZIndex = 5, Parent = target })
		b.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
			fn(input.Position)
			self:startDrag(fn, nil)
		end)
	end
	dragOn(sv, function(pos)
		s = math.clamp((pos.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
		v = 1 - math.clamp((pos.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
		paint(true)
	end)
	dragOn(hue, function(pos)
		h = math.clamp((pos.X - hue.AbsolutePosition.X) / hue.AbsoluteSize.X, 0, 0.999)
		paint(true)
	end)
	for i, col in ipairs(PRESETS) do
		local b = inst("TextButton", { Text = "", AutoButtonColor = false, BackgroundColor3 = col, Position = off(10 + (i - 1) * 30, 138), Size = off(26, 18), Parent = p })
		corner(b, 4)
		b.MouseButton1Click:Connect(function()
			h, s, v = col:ToHSV()
			paint(true)
			sfx("tick")
		end)
	end
	p.Position += off(0, 6)
	pop(p, 0.3, { Position = p.Position - off(0, 6) })
end

