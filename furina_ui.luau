local gameName = nil
function Window:buildHome(pg)
	local cw = pg.cw
	-- hero
	local slot = frame({ BackgroundTransparency = 1, Size = off(cw, 84), Parent = pg.canvas })
	local face = frame({ Size = UDim2.fromScale(1, 1), ClipsDescendants = true, Parent = slot })
	corner(face, 12)
	bind(face, { BackgroundColor3 = "panel", BackgroundTransparency = "panelT" })
	bind(strokeOf(face, C.line, 1, C.lineT), { Color = "line", Transparency = "lineT" })
	local sheen = frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, Parent = face })
	bind(inst("UIGradient", { Rotation = 0, Transparency = NumberSequence.new(0.75, 1), Parent = sheen }), { Color = function(c) return ColorSequence.new(c.hydro, c.hydro) end })
	local ava = image({ Position = off(14, 18), Size = off(46, 46), BackgroundTransparency = 0, ZIndex = 2, Parent = face })
	bind(ava, { BackgroundColor3 = "hydro" })
	corner(ava, -1)
	bind(strokeOf(ava, C.gold, 2, 0), { Color = "gold" })
	task.spawn(function()
		local ok, img = pcall(function()
			return Players:GetUserThumbnailAsync(LP.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
		end)
		if ok and ava.Parent then ava.Image = img end
	end)
	local online = frame({ AnchorPoint = V2(1, 1), Position = UDim2.fromScale(1, 1), Size = off(11, 11), BackgroundColor3 = rgb(82, 224, 138), ZIndex = 3, Parent = ava })
	corner(online, -1)
	bind(strokeOf(online, C.bg, 2, 0), { Color = "bg" })
	local wb = text({ Text = spaced("Welcome back"), TextSize = 9, FontFace = F_BOLD, Position = off(72, 14), Size = off(200, 12), ZIndex = 2, Parent = face })
	bind(wb, { TextColor3 = "mute" })
	local nm = text({ Text = LP.DisplayName, TextSize = 16, FontFace = F_TITLE, Position = off(72, 26), Size = U2(1, -170, 0, 20), TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 2, Parent = face })
	bind(nm, { TextColor3 = "text" })
	local gl = text({ Text = "", TextSize = 11, FontFace = F_REG, RichText = true, Position = off(72, 46), Size = U2(1, -170, 0, 14), TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 2, Parent = face })
	bind(gl, { TextColor3 = "mute" })
	local function paintGame()
		if gl.Parent then
			gl.Text = "Playing <b>" .. (gameName or "this game") .. "</b> · server <b>#" .. (game.JobId ~= "" and game.JobId:sub(1, 4):upper() or "STUDIO") .. "</b>"
		end
	end
	paintGame()
	if not gameName then
		task.spawn(function()
			local ok, info = pcall(function() return MarketplaceService:GetProductInfo(game.PlaceId) end)
			gameName = ok and info and info.Name or "this game"
			paintGame()
		end)
	end
	local quote = text({ Text = "“" .. QUOTES[self.quoteI % #QUOTES + 1] .. "”", TextSize = 11, FontFace = F_ITAL, Position = off(72, 62), Size = U2(1, -170, 0, 14), ZIndex = 2, Parent = face })
	bind(quote, { TextColor3 = "gold" })
	self.homeQuote = quote
	-- the crystal: an actual 3D part spinning inside a ViewportFrame, with two orbit rings around it
	local gemBox = frame({ BackgroundTransparency = 1, AnchorPoint = V2(1, 0.5), Position = U2(1, -16, 0.5, 0), Size = off(70, 70), ZIndex = 2, Parent = face })
	local r1 = frame({ BackgroundTransparency = 1, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = off(66, 20), ZIndex = 2, Parent = gemBox })
	corner(r1, -1)
	bind(strokeOf(r1, C.gold, 1.5, 0.1), { Color = "gold" })
	local r2 = frame({ BackgroundTransparency = 1, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = off(54, 16), Rotation = 60, ZIndex = 2, Parent = gemBox })
	corner(r2, -1)
	bind(strokeOf(r2, C.aqua, 1.2, 0.35), { Color = "aqua" })
	local vp = inst("ViewportFrame", { BackgroundTransparency = 1, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = off(58, 58), ZIndex = 3,
		Ambient = rgb(150, 175, 215), LightColor = WHITE, LightDirection = Vector3.new(-1, -1.4, -0.6), Parent = gemBox })
	local cam = inst("Camera", { FieldOfView = 26, CFrame = CFrame.new(Vector3.new(0, 0.25, 6), Vector3.zero), Parent = vp })
	vp.CurrentCamera = cam
	local gem = inst("Part", { Anchored = true, CanCollide = false, Size = Vector3.new(1.15, 1.15, 1.15), Material = Enum.Material.SmoothPlastic, Reflectance = 0.15, Parent = vp })
	bind(gem, { Color = "hydro" })
	local core = inst("Part", { Anchored = true, CanCollide = false, Size = Vector3.new(0.62, 0.62, 0.62), Color = WHITE, Material = Enum.Material.SmoothPlastic, Transparency = 0.3, Parent = vp })
	local base = CFrame.fromAxisAngle(Vector3.new(-1, 0, 1).Unit, math.acos(1 / math.sqrt(3)))
	local spin = inst("NumberValue", { Parent = gemBox })
	local function placeGem()
		local cf = CFrame.Angles(math.rad(-14), math.rad(spin.Value), 0) * base
		gem.CFrame = cf
		core.CFrame = CFrame.Angles(0, math.rad(-spin.Value * 1.5), 0) * base
	end
	spin.Changed:Connect(placeGem)
	placeGem()
	if not LITE then
		loop("page", spin, TweenInfo.new(6, EQ.Linear, ED.In, -1), { Value = 360 })
		loop("page", r1, TweenInfo.new(5, EQ.Linear, ED.In, -1), { Rotation = 360 })
		loop("page", r2, TweenInfo.new(7, EQ.Linear, ED.In, -1), { Rotation = 420 })
		loop("page", gemBox, TweenInfo.new(1.7, EQ.Sine, ED.InOut, -1, true), { Position = U2(1, -16, 0.5, -4) })
	end
	pg:add({ slot = slot, face = face, h = 84, wide = true, kind = "custom" })

	-- live stats
	local sslot = frame({ BackgroundTransparency = 1, Size = off(cw, 54), Parent = pg.canvas })
	local stats = {}
	local cellW = (cw - GAP * 3) / 4
	for i, name in ipairs({ "FPS", "Ping", "Players", "Session" }) do
		local cell = frame({ Position = off((i - 1) * (cellW + GAP), 0), Size = U2(0, cellW, 1, 0), Parent = sslot })
		corner(cell, 11)
		bind(cell, { BackgroundColor3 = "panel", BackgroundTransparency = "panelT" })
		bind(strokeOf(cell, C.line, 1, C.lineT), { Color = "line", Transparency = "lineT" })
		local l = text({ Text = spaced(name), TextSize = 9, FontFace = F_BOLD, Position = off(12, 9), Size = off(100, 12), Parent = cell })
		bind(l, { TextColor3 = "mute" })
		local v = text({ Text = "0", TextSize = 17, FontFace = F_BOLD, RichText = true, Position = off(12, 24), Size = off(110, 22), Parent = cell })
		bind(v, { TextColor3 = "text" })
		stats[name] = { cell = cell, value = v }
	end
	local bars = {}
	for i = 1, 14 do
		local b = frame({ AnchorPoint = V2(0, 1), Position = U2(1, -12 - (15 - i) * 3, 1, -12), Size = off(2, 2), Parent = stats.FPS.cell })
		bind(b, { BackgroundColor3 = "aqua" })
		bars[i] = b
	end
	local dot = frame({ AnchorPoint = V2(1, 0), Position = U2(1, -10, 0, 10), Size = off(7, 7), BackgroundColor3 = rgb(82, 224, 138), Parent = stats.Ping.cell })
	corner(dot, -1)
	self.homeStats = { stats = stats, bars = bars, dot = dot }
	pg:add({ slot = sslot, face = sslot, h = 54, wide = true, kind = "custom" })

	-- pinned switches
	Build.section(pg, { name = "Quick toggles" }, true)
	local pinned = 0
	for _, it in ipairs(self:allItems()) do
		if it.kind == "toggle" and S.Pins[it.id] then
			buildItem(pg, it)
			pinned += 1
		end
	end
	if pinned == 0 then Build.label(pg, { name = "Tap the star on any switch to pin it here.", opts = { Style = 1 } }) end

	-- what is on right now
	Build.section(pg, { name = "On right now" }, true)
	local oslot = frame({ BackgroundTransparency = 1, Size = off(cw, 30), Parent = pg.canvas })
	local oe = pg:add({ slot = oslot, face = oslot, h = 30, wide = true, kind = "custom" })
	self.refreshOnList = function()
		if not oslot.Parent then return end
		oslot:ClearAllChildren()
		local chips = {}
		for _, it in ipairs(self:allItems()) do
			if it.kind == "toggle" and it.value then chips[#chips + 1] = { it = it, w = textWidth(it.name, 12) + 40 } end
		end
		local extra = 0
		if #chips > 8 then
			extra = #chips - 8
			for i = #chips, 9, -1 do
				table.remove(chips, i)
			end
		end
		if #chips == 0 then
			local l = text({ Text = "Nothing on. A quiet night at the opera.", TextSize = 12, FontFace = F_ITAL, Size = U2(1, 0, 0, 24), Parent = oslot })
			bind(l, { TextColor3 = "mute" })
		end
		if extra > 0 then chips[#chips + 1] = { more = extra, w = textWidth("+" .. extra .. " more", 12) + 20 } end
		local h = chipLayout(chips, cw)
		for i, c in ipairs(chips) do
			local b = inst("TextButton", { AutoButtonColor = false, Text = "", Position = off(c.x, c.y), Size = off(c.w, 24), Parent = oslot })
			corner(b, 8)
			bind(b, { BackgroundColor3 = "hydro" })
			b.BackgroundTransparency = 0.82
			if c.more then
				local l = text({ Text = "+" .. c.more .. " more", TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = b })
				bind(l, { TextColor3 = "mute" })
			else
				local d = frame({ AnchorPoint = V2(0, 0.5), Position = U2(0, 9, 0.5, 0), Size = off(6, 6), Parent = b })
				corner(d, -1)
				bind(d, { BackgroundColor3 = "aqua" })
				local l = text({ Text = c.it.name, TextSize = 12, Position = off(20, 0), Size = U2(1, -40, 1, 0), Parent = b })
				bind(l, { TextColor3 = "text" })
				local x = text({ Text = "×", TextSize = 14, FontFace = F_BOLD, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = V2(1, 0.5), Position = U2(1, -4, 0.5, 0), Size = off(16, 16), Parent = b })
				bind(x, { TextColor3 = "mute" })
				b.MouseEnter:Connect(function() x.TextColor3 = rgb(255, 143, 156) end)
				b.MouseLeave:Connect(function() x.TextColor3 = C.mute end)
				b.MouseButton1Click:Connect(function()
					c.it:set(false, true)
					sfx("off")
				end)
				if not LITE then
					b.Size = off(c.w * 0.85, 20)
					pop(b, 0.3, { Size = off(c.w, 24) }, (i - 1) * 0.02)
				end
			end
		end
		if oe.h ~= h then
			oe.h = h
			pg:layout(false)
		end
	end
	self.refreshOnList()
	self:tickHome()
end

local frameCount, fpsValue, fpsHist = 0, 60, {}
function Window:tickHome()
	local hs = self.homeStats
	if not hs or not hs.dot.Parent or not (self.current and self.current.home) then return end
	local ping = 0
	pcall(function() ping = math.floor(LP:GetNetworkPing() * 1000 + 0.5) end)
	if ping <= 0 then
		pcall(function() ping = math.floor(StatsService.Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5) end)
	end
	local sec = math.floor(os.clock() - self.startClock)
	hs.stats.FPS.value.Text = tostring(fpsValue)
	hs.stats.Ping.value.Text = ping .. ' <font size="11" transparency="0.4">ms</font>'
	hs.stats.Players.value.Text = #Players:GetPlayers() .. ' <font size="11" transparency="0.4">/ ' .. Players.MaxPlayers .. "</font>"
	hs.stats.Session.value.Text = string.format("%02d:%02d", math.floor(sec / 60) % 100, sec % 60)
	local dc = ping < 100 and rgb(82, 224, 138) or (ping < 200 and rgb(255, 198, 92) or rgb(255, 110, 130))
	hs.dot.BackgroundColor3 = dc
	local mx = 30
	for _, f in ipairs(fpsHist) do
		mx = math.max(mx, f)
	end
	for i, b in ipairs(hs.bars) do
		local f = fpsHist[#fpsHist - #hs.bars + i] or 0
		b.Size = off(2, math.max(2, math.floor(f / mx * 16)))
	end
end

