local EQ, ED = Enum.EasingStyle, Enum.EasingDirection
local V2, U2 = Vector2.new, UDim2.new
local function off(x, y) return UDim2.fromOffset(x, y) end
local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end
local WHITE, BLACK = Color3.new(1, 1, 1), Color3.new(0, 0, 0)

local function tw(o, t, props, style, dir, delay)
	local tween = TweenService:Create(o, TweenInfo.new(t, style or EQ.Quint, dir or ED.Out, 0, false, delay or 0), props)
	tween:Play()
	return tween
end
local function pop(o, t, props, delay) return tw(o, t, props, EQ.Back, ED.Out, delay) end

local function inst(class, props, kids)
	local o = Instance.new(class)
	local parent
	if props then
		parent = props.Parent
		props.Parent = nil
		for k, v in pairs(props) do
			o[k] = v
		end
	end
	if kids then
		for _, k in ipairs(kids) do
			k.Parent = o
		end
	end
	if parent then o.Parent = parent end
	return o
end
local function frame(p)
	p.BorderSizePixel = 0
	return inst("Frame", p)
end
local function corner(p, px) return inst("UICorner", { CornerRadius = px < 0 and UDim.new(1, 0) or UDim.new(0, px), Parent = p }) end
local function strokeOf(p, color, th, tr)
	return inst("UIStroke", { Color = color, Thickness = th or 1, Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = p })
end

local FONT_FAMILY = "rbxasset://fonts/families/GothamSSm.json"
local F_REG = Font.new(FONT_FAMILY, Enum.FontWeight.Regular)
local F_MED = Font.new(FONT_FAMILY, Enum.FontWeight.Medium)
local F_BOLD = Font.new(FONT_FAMILY, Enum.FontWeight.Bold)
local F_ITAL = Font.new(FONT_FAMILY, Enum.FontWeight.Regular, Enum.FontStyle.Italic)
local F_TITLE = Font.new("rbxasset://fonts/families/Merriweather.json", Enum.FontWeight.Bold)

local function text(p)
	p.BackgroundTransparency = 1
	p.BorderSizePixel = 0
	p.FontFace = p.FontFace or F_MED
	p.TextXAlignment = p.TextXAlignment or Enum.TextXAlignment.Left
	return inst("TextLabel", p)
end
local function image(p)
	p.BackgroundTransparency = 1
	p.BorderSizePixel = 0
	return inst("ImageLabel", p)
end
local function hitbox(p)
	p.BackgroundTransparency = 1
	p.BorderSizePixel = 0
	p.Text = ""
	p.AutoButtonColor = false
	return inst("TextButton", p)
end
local function spaced(s) return (s:upper():gsub("(.)", "%1 "):sub(1, -2)) end
local function textWidth(s, size, font)
	local ok, v = pcall(function() return TextService:GetTextSize(s, size, font or Enum.Font.GothamMedium, V2(10000, 100)).X end)
	return ok and v or #s * size * 0.6
end
local function safeCall(fn, ...)
	if type(fn) ~= "function" then return end
	local args = table.pack(...)
	task.spawn(function()
		local ok, err = pcall(fn, table.unpack(args, 1, args.n))
		if not ok then warn("[FurinaUI] callback error: " .. tostring(err)) end
	end)
end

