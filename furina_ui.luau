local toastOrder = 0
local function toast(title, content, duration, force)
	if not force and not S.Notify then return end
	ensureGui()
	duration = duration or 3
	toastOrder += 1
	local textH = TextService:GetTextSize(tostring(content or ""), 12, Enum.Font.Gotham, V2(196, 1000)).Y
	local h = math.max(52, textH + 34)
	local holder = frame({ BackgroundTransparency = 1, Size = off(250, h), LayoutOrder = toastOrder, Parent = toastHolder })
	local card = frame({ Size = UDim2.fromScale(1, 1), Position = off(280, 0), Parent = holder })
	bind(card, { BackgroundColor3 = "toast" })
	card.BackgroundTransparency = 0.04
	corner(card, 12)
	bind(strokeOf(card, C.aqua, 1, 0.65), { Color = "aqua" })
	local accent = frame({ Size = U2(0, 3, 1, -20), Position = off(0, 10), Parent = card })
	bind(accent, { BackgroundColor3 = "gold" })
	corner(accent, 2)
	if Assets.emblem then
		image({ Image = Assets.emblem, Size = off(20, 22), Position = off(12, 13), Parent = card })
	end
	local t1 = text({ Text = tostring(title or "Furina Hub"), TextSize = 13, FontFace = F_TITLE, Position = off(40, 9), Size = U2(1, -50, 0, 16), Parent = card })
	bind(t1, { TextColor3 = "gold" })
	local t2 = text({ Text = tostring(content or ""), TextSize = 12, FontFace = F_REG, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top,
		Position = off(40, 27), Size = U2(1, -50, 1, -32), Parent = card })
	bind(t2, { TextColor3 = "mute" })
	local bar = frame({ Size = U2(1, 0, 0, 2), Position = U2(0, 0, 1, -2), Parent = card })
	bind(bar, { BackgroundColor3 = "hydro" })
	pop(card, 0.45, { Position = off(0, 0) })
	tw(bar, duration, { Size = U2(0, 0, 0, 2) }, EQ.Linear)
	task.delay(duration, function()
		tw(card, 0.3, { Position = off(280, 0) }, EQ.Quint, ED.In)
		task.delay(0.32, function() holder:Destroy() end)
	end)
end

------------------------------------------------------------------------------------------------------
-- the window
------------------------------------------------------------------------------------------------------
local Window = {}
Window.__index = Window
local Tab = {}
Tab.__index = Tab

local DESK = { W = 540, H = 400, rail = 54, head = 50, foot = 26 }
local PHONE = { W = 520, H = 336, rail = 54, head = 44, foot = 0 }

local function isPhone()
	local vs = workspace.CurrentCamera.ViewportSize
	return UserInputService.TouchEnabled and (vs.X < 1100 or vs.Y < 520)
end
local function baseScale(D)
	local vs = workspace.CurrentCamera.ViewportSize
	if D == PHONE then return math.min(1.15, (vs.X - 24) / (D.W + 4), (vs.Y - 40) / (D.H + 4)) end
	return math.min(1.1, (vs.X - 24) / (D.W + 4), (vs.Y - 58) / (D.H + 4))
end

-- one item = one control's data; pages are rebuilt from items, so a control can appear in a tab, on Home and in search results
local Item = {}
Item.__index = Item
local function newItem(kind, tab, opts)
	local it = setmetatable({ kind = kind, tab = tab, opts = opts, name = opts.Name or opts.Text or "", desc = opts.Description or opts.Desc }, Item)
	it.id = (tab and tab.name or "?") .. "/" .. it.name
	it.cb = opts.Callback
	return it
end
function Item:refresh(anim)
	if self.view then pcall(self.view, anim) end
end
function Item:set(v, fire)
	self.value = v
	self:refresh(true)
	if fire then safeCall(self.cb, v) end
	if W then W:onItemChanged(self) end
end
local function handle(it)
	local h = {}
	function h.Set(_, v)
		if it.kind == "toggle" then
			it:set(v == true, true)
		elseif it.kind == "slider" then
			local lo, hi = it.opts.Range[1], it.opts.Range[2]
			it:set(math.clamp(tonumber(v) or lo, lo, hi), true)
		elseif it.kind == "dropdown" then
			if it.multi then
				it:set(type(v) == "table" and v or { v }, true)
			else
				it:set(type(v) == "table" and v[1] or v, true)
			end
		elseif it.kind == "color" then
			it:set(v, true)
		elseif it.kind == "input" then
			it:set(tostring(v), true)
		elseif it.kind == "bind" then
			local name = typeof(v) == "EnumItem" and v.Name or tostring(v)
			it:set(name, false)
			safeCall(it.opts.OnChangedCallback, Enum.KeyCode[name])
		elseif it.kind == "label" then
			it.name = tostring(v)
			it:refresh()
		end
	end
	function h.Get() return it.value end
	function h.Destroy() end
	h.Item = it
	return h
end

------------------------------------------------------------------------------------------------------
-- page building
------------------------------------------------------------------------------------------------------
local Page = {}
Page.__index = Page

function Window:newPage()
	local D = self.D
	local canvas = inst("ScrollingFrame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), CanvasSize = off(0, 0),
		ScrollBarThickness = 3, ScrollBarImageTransparency = 0.5, ScrollingDirection = Enum.ScrollingDirection.Y,
		ElasticBehavior = Enum.ElasticBehavior.Never, Parent = self.body,
	})
	bind(canvas, { ScrollBarImageColor3 = "aqua" })
	local pg = setmetatable({ win = self, canvas = canvas, els = {}, cw = D.W - D.rail - PAD * 2 - 4, n = 0 }, Page)
	return pg
end

function Page:add(e)
	self.n += 1
	e.index = self.n
	self.els[#self.els + 1] = e
	return e
end

-- manual layout: two columns, wide items span both, an odd tile at the end of a run spans both, folded sections hide their tiles
function Page:layout(animate)
	local cw, y = self.cw, 10
	local half = math.floor((cw - GAP) / 2)
	local visible, folded = {}, false
	for _, e in ipairs(self.els) do
		if e.kind == "sec" then
			folded = e.folded and true or false
			visible[#visible + 1] = e
			e.slot.Visible = true
		else
			e.slot.Visible = not folded
			if not folded then visible[#visible + 1] = e end
		end
	end
	local run = {}
	local function flush()
		if #run % 2 == 1 then run[#run].span = true end
		run = {}
	end
	for _, e in ipairs(visible) do
		e.span = e.wide or false
		if e.kind ~= "tile" or e.wide then
			flush()
		else
			run[#run + 1] = e
		end
	end
	flush()
	local function place(e, x, yy, w, h)
		local p, s = off(PAD + x, yy), off(w, h)
		if animate then
			tw(e.slot, 0.28, { Position = p, Size = s })
		else
			e.slot.Position, e.slot.Size = p, s
		end
	end
	local pending = nil
	for i, e in ipairs(visible) do
		if e.kind == "sec" or e.span then
			if pending then
				y += pending.h + GAP
				pending = nil
			end
			if e.kind == "sec" and i > 1 then y += 6 end
			place(e, 0, y, cw, e.h)
			y += e.h + (e.kind == "sec" and 6 or GAP)
		elseif not pending then
			pending = e
			place(e, 0, y, half, e.h)
		else
			local h = math.max(pending.h, e.h)
			place(pending, 0, y, half, h)
			place(e, half + GAP, y, cw - half - GAP, h)
			y += h + GAP
			pending = nil
		end
	end
	if pending then y += pending.h + GAP end
	self.canvas.CanvasSize = off(0, y + 6)
end

-- entrance: each tile slides up and fades in, one after another
local function fadeIn(root, delay)
	if LITE then return end
	local list = { root }
	for _, d in ipairs(root:GetDescendants()) do
		list[#list + 1] = d
	end
	for _, o in ipairs(list) do
		local props = {}
		if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
			if o.TextTransparency < 1 then props.TextTransparency = o.TextTransparency end
		end
		if o:IsA("ImageLabel") or o:IsA("ImageButton") then
			if o.ImageTransparency < 1 then props.ImageTransparency = o.ImageTransparency end
		end
		if o:IsA("GuiObject") and o.BackgroundTransparency < 1 then props.BackgroundTransparency = o.BackgroundTransparency end
		if o:IsA("UIStroke") and o.Transparency < 1 then props.Transparency = o.Transparency end
		if next(props) then
			for k in pairs(props) do
				o[k] = 1
			end
			tw(o, 0.4, props, EQ.Quint, ED.Out, delay)
		end
	end
end

function Page:tile(it, h, wide)
	local win = self.win
	local slot = frame({ BackgroundTransparency = 1, Size = off(100, h), Parent = self.canvas })
	local face = frame({ Size = UDim2.fromScale(1, 1), ClipsDescendants = true, Parent = slot })
	corner(face, 10)
	bind(face, { BackgroundColor3 = "panel", BackgroundTransparency = "panelT" })
	local st = strokeOf(face, C.line, 1, C.lineT)
	bind(st, { Color = "line", Transparency = "lineT" })
	local light = soft({ Size = off(200, 200), AnchorPoint = V2(0.5, 0.5), ImageTransparency = 1, ZIndex = 1, Parent = face })
	if light then bind(light, { ImageColor3 = "aqua" }) end
	local e = { slot = slot, face = face, h = h, wide = wide, kind = "tile", item = it, stroke = st }
	local hovering = false
	face.MouseEnter:Connect(function()
		hovering = true
		win:help(it and it.desc)
		tw(face, 0.22, { Position = off(0, -2) }, EQ.Back)
		tw(st, 0.2, { Color = C.aqua, Transparency = 0.5 })
		if light and not LITE then tw(light, 0.2, { ImageTransparency = 0.86 }) end
	end)
	face.MouseLeave:Connect(function()
		hovering = false
		win:help(nil)
		tw(face, 0.25, { Position = off(0, 0) })
		tw(st, 0.25, { Color = C.line, Transparency = C.lineT })
		if light then tw(light, 0.2, { ImageTransparency = 1 }) end
	end)
	if light then
		face.MouseMoved:Connect(function()
			if hovering then
				local x, y = mouseIn(face, win.scale.Scale)
				light.Position = off(x, y)
			end
		end)
	end
	-- phones have no hover: holding a tile shows its description
	if it and it.desc then
		face.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				e.holdStart = os.clock()
				task.delay(0.5, function()
					if e.holdStart and os.clock() - e.holdStart >= 0.49 then
						e.longPressed = true
						toast(it.name, it.desc, 2.6, true)
					end
				end)
			end
		end)
		face.InputEnded:Connect(function() e.holdStart = nil end)
	end
	return self:add(e)
end

-- a full-size click catcher on top of a tile
local function clicker(e, fn)
	local b = hitbox({ Size = UDim2.fromScale(1, 1), ZIndex = 6, Parent = e.face })
	b.MouseButton1Click:Connect(function()
		if e.longPressed then
			e.longPressed = false
			return
		end
		fn()
	end)
	return b
end

local function nameLabel(e, it, yScale, yOff, rightPad)
	local l = text({ Text = it.name, TextSize = 13, FontFace = F_MED, AnchorPoint = V2(0, 0.5), Position = U2(0, 12, yScale or 0.5, yOff or 0),
		Size = U2(1, -(rightPad or 70), 0, 16), TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 3, Parent = e.face })
	bind(l, { TextColor3 = "text" })
	return l
end

------------------------------------------------------------------------------------------------------
-- controls
------------------------------------------------------------------------------------------------------
local Build = {}

function Build.toggle(pg, it)
	local win = pg.win
	local e = pg:tile(it, 36, false)
	local pinnable = it.tab and not it.tab.internal
	nameLabel(e, it, 0.5, 0, pinnable and 86 or 64)
	local track = frame({ AnchorPoint = V2(1, 0.5), Position = U2(1, -12, 0.5, 0), Size = off(38, 20), ClipsDescendants = true, ZIndex = 3, Parent = e.face })
	corner(track, -1)
	bind(track, { BackgroundColor3 = "track", BackgroundTransparency = "trackT" })
	local fill = frame({ Size = UDim2.fromScale(it.value and 1 or 0, 1), BackgroundColor3 = WHITE, ZIndex = 3, Parent = track })
	corner(fill, -1)
	bind(inst("UIGradient", { Parent = fill }), { Color = "accentSeq" })
	local knob = frame({ AnchorPoint = V2(0, 0.5), Position = U2(0, it.value and 21 or 3, 0.5, 0), Size = off(14, 14), BackgroundColor3 = WHITE, ZIndex = 4, Parent = track })
	corner(knob, -1)
	inst("UIGradient", { Rotation = 60, Color = ColorSequence.new(WHITE, rgb(205, 228, 255)), Parent = knob })
	local ring = strokeOf(track, C.aqua, 1, it.value and 0.45 or 1)
	bind(ring, { Color = "aqua" })
	local star
	if pinnable then
		star = icon("star", 13, e.face, nil)
		star.AnchorPoint = V2(0.5, 0.5)
		star.Position = U2(1, -66, 0.5, 0)
		star.ZIndex = 7
		local function paintStar()
			local pinned = S.Pins[it.id] == true
			if star:IsA("ImageLabel") then
				star.ImageColor3 = pinned and C.gold or C.mute
				star.ImageTransparency = pinned and 0 or 0.65
			else
				star.TextColor3 = pinned and C.gold or C.mute
			end
		end
		paintStar()
		local sb = hitbox({ AnchorPoint = V2(0.5, 0.5), Position = U2(1, -66, 0.5, 0), Size = off(22, 22), ZIndex = 8, Parent = e.face })
		sb.MouseButton1Click:Connect(function()
			S.Pins[it.id] = (not S.Pins[it.id]) or nil
			saveSettings()
			paintStar()
			sfx("pop")
			pop(star, 0.35, { Rotation = star.Rotation + 72 })
			if S.Pins[it.id] then splash(star, { C.gold, rgb(255, 243, 200) }, 7) end
			toast(S.Pins[it.id] and "Pinned to Home" or "Unpinned", it.name, 2)
			if win.current and win.current.home then win:showTab(win.current, false, true) end
		end)
	end
	it.view = function(anim)
		if not track.Parent then return end
		local v = it.value
		if anim then
			tw(fill, 0.26, { Size = UDim2.fromScale(v and 1 or 0, 1) })
			pop(knob, 0.3, { Position = U2(0, v and 21 or 3, 0.5, 0) })
			tw(knob, 0.12, { Size = off(19, 14) })
			task.delay(0.12, function()
				if knob.Parent then tw(knob, 0.18, { Size = off(14, 14) }) end
			end)
			tw(ring, 0.25, { Transparency = v and 0.45 or 1 })
		else
			fill.Size = UDim2.fromScale(v and 1 or 0, 1)
			knob.Position = U2(0, v and 21 or 3, 0.5, 0)
			ring.Transparency = v and 0.45 or 1
		end
	end
	clicker(e, function()
		ripple(e.face, win.scale.Scale)
		it:set(not it.value, true)
		sfx(it.value and "on" or "off")
		if it.value then splash(track, { C.aqua, C.hydro, WHITE }) end
	end)
	return e
end

local function fmtNum(v, inc)
	if inc and inc < 1 then
		local decimals = math.min(3, math.max(1, math.ceil(-math.log10(inc))))
		return string.format("%." .. decimals .. "f", v)
	end
	return tostring(math.floor(v + 0.5))
end

function Build.slider(pg, it)
	local win = pg.win
	local o = it.opts
	local lo, hi, inc = o.Range[1], o.Range[2], o.Increment or 1
	local suffix = o.Suffix or ""
	local e = pg:tile(it, 52, false)
	e.face.ZIndex = 2
	nameLabel(e, it, 0, 17, 84)
	local val = inst("TextButton", { BackgroundTransparency = 1, AutoButtonColor = false, Text = "", TextSize = 12, FontFace = F_BOLD,
		TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = V2(1, 0.5), Position = U2(1, -12, 0, 17), Size = off(72, 16), ZIndex = 7, Parent = e.face })
	bind(val, { TextColor3 = "aqua" })
	local track = frame({ AnchorPoint = V2(0, 0.5), Position = U2(0, 12, 1, -15), Size = U2(1, -24, 0, 4), ZIndex = 3, Parent = e.face })
	corner(track, -1)
	bind(track, { BackgroundColor3 = "track", BackgroundTransparency = "trackT" })
	local fill = frame({ Size = UDim2.fromScale(0, 1), BackgroundColor3 = WHITE, ClipsDescendants = true, ZIndex = 3, Parent = track })
	corner(fill, -1)
	bind(inst("UIGradient", { Parent = fill }), { Color = "accentSeq" })
	if not LITE then
		local shine = frame({ Size = U2(0, 40, 1, 0), Position = off(-40, 0), BackgroundColor3 = WHITE, ZIndex = 4, Parent = fill })
		inst("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.45), NumberSequenceKeypoint.new(1, 1) }), Parent = shine })
		loop("page", shine, TweenInfo.new(2.8, EQ.Linear, ED.In, -1), { Position = U2(0, 480, 0, 0) })
	end
	local thumb = frame({ AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = off(14, 14), BackgroundColor3 = WHITE, ZIndex = 5, Parent = track })
	corner(thumb, -1)
	bind(strokeOf(thumb, C.aqua, 2, 0), { Color = "aqua" })
	local bubble = text({ AnchorPoint = V2(0.5, 1), Position = U2(0, 0, 0, -10), Size = off(46, 18), TextSize = 11, FontFace = F_BOLD,
		TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = WHITE, BackgroundTransparency = 1, Visible = false, ZIndex = 9, Parent = track })
	local bubbleBg = frame({ Size = UDim2.fromScale(1, 1), ZIndex = 8, Parent = bubble })
	corner(bubbleBg, 8)
	bind(bubbleBg, { BackgroundColor3 = "hydro" })
	local function snap(v)
		v = math.clamp(v, lo, hi)
		v = lo + math.floor((v - lo) / inc + 0.5) * inc
		return math.clamp(v, lo, hi)
	end
	it.view = function(anim)
		if not track.Parent then return end
		local p = (hi > lo) and (it.value - lo) / (hi - lo) or 0
		local label = fmtNum(it.value, inc) .. suffix
		val.Text = label
		bubble.Text = label
		bubble.Position = U2(p, 0, 0, -10)
		if anim then
			tw(fill, 0.12, { Size = UDim2.fromScale(p, 1) })
			tw(thumb, 0.12, { Position = UDim2.fromScale(p, 0.5) })
		else
			fill.Size = UDim2.fromScale(p, 1)
			thumb.Position = UDim2.fromScale(p, 0.5)
		end
	end
	it.view(false)
	local hit = hitbox({ Position = U2(0, 0, 1, -30), Size = U2(1, 0, 0, 30), ZIndex = 6, Parent = e.face })
	local function setFromX(x)
		local p = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
		local v = snap(lo + p * (hi - lo))
		if v ~= it.value then
			it:set(v, true)
			sfx("tick")
		end
	end
	hit.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		bubble.Visible = true
		bubble.Size = off(20, 10)
		pop(bubble, 0.22, { Size = off(46, 18) })
		pop(thumb, 0.2, { Size = off(18, 18) })
		setFromX(input.Position.X)
		win:startDrag(function(pos) setFromX(pos.X) end, function()
			bubble.Visible = false
			tw(thumb, 0.2, { Size = off(14, 14) })
			safeCall(o.OnRelease, it.value)
		end)
	end)
	-- click the number to type a value
	val.MouseButton1Click:Connect(function()
		local box = inst("TextBox", { Text = fmtNum(it.value, inc), TextSize = 12, FontFace = F_BOLD, ClearTextOnFocus = false,
			TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = val.AnchorPoint, Position = val.Position, Size = off(60, 18), ZIndex = 9, Parent = e.face })
		bind(box, { TextColor3 = "text", BackgroundColor3 = "track" })
		box.BackgroundTransparency = 0.2
		corner(box, 5)
		bind(strokeOf(box, C.aqua, 1, 0.2), { Color = "aqua" })
		val.Visible = false
		box:CaptureFocus()
		box.FocusLost:Connect(function()
			local n = tonumber((box.Text:gsub("[^%d%.%-]", "")))
			if n then
				it:set(snap(n), true)
				sfx("ok")
				safeCall(o.OnRelease, it.value)
			end
			val.Visible = true
			box:Destroy()
		end)
	end)
	return e
end

-- liquid pill: the leading edge moves first, the trailing edge catches up
local function liquidPill(pill, pad)
	local L, R = inst("NumberValue"), inst("NumberValue")
	local function apply()
		pill.Position = off(L.Value, pad)
		pill.Size = U2(0, math.max(4, R.Value - L.Value), 1, -pad * 2)
	end
	L.Changed:Connect(apply)
	R.Changed:Connect(apply)
	return function(l, r, instant)
		if instant then
			L.Value, R.Value = l, r
			apply()
			return
		end
		local right = l > L.Value
		local fast = TweenInfo.new(0.16, EQ.Quart, ED.Out)
		local slow = TweenInfo.new(0.32, EQ.Quart, ED.Out, 0, false, 0.03)
		TweenService:Create(L, right and slow or fast, { Value = l }):Play()
		TweenService:Create(R, right and fast or slow, { Value = r }):Play()
	end
end

local function chipLayout(list, maxW)
	local x, y, rowH = 0, 0, 24
	for _, c in ipairs(list) do
		local w = c.w
		if x > 0 and x + w > maxW then
			x = 0
			y += rowH + 6
		end
		c.x, c.y = x, y
		x += w + 6
	end
	return y + rowH
end

function Build.dropdown(pg, it)
	local opts = it.opts.Options or {}
	local short = not it.multi and #opts <= 3
	if short then
		local total = 4
		for _, o in ipairs(opts) do
			total += textWidth(tostring(o), 12) + 22
		end
		if total > pg.cw * 0.6 then short = false end
	end
	if short then
		-- segmented control
		local e = pg:tile(it, 36, true)
		nameLabel(e, it, 0.5, 0, 220)
		local widths, total = {}, 4
		for i, o in ipairs(opts) do
			widths[i] = textWidth(tostring(o), 12) + 22
			total += widths[i]
		end
		local seg = frame({ AnchorPoint = V2(1, 0.5), Position = U2(1, -10, 0.5, 0), Size = off(total, 24), ZIndex = 3, Parent = e.face })
		corner(seg, 8)
		bind(seg, { BackgroundColor3 = "track", BackgroundTransparency = "trackT" })
		local pill = frame({ ZIndex = 4, Parent = seg })
		corner(pill, 6)
		bind(pill, { BackgroundColor3 = "hydro" })
		local move = liquidPill(pill, 2)
		local buttons, xs = {}, {}
		local x = 2
		for i, o in ipairs(opts) do
			xs[i] = x
			local b = inst("TextButton", { BackgroundTransparency = 1, AutoButtonColor = false, Text = tostring(o), TextSize = 12, FontFace = F_MED,
				Position = off(x, 0), Size = U2(0, widths[i], 1, 0), ZIndex = 5, Parent = seg })
			buttons[i] = b
			x += widths[i]
			b.MouseButton1Click:Connect(function()
				if it.value ~= o then
					it:set(o, true)
					sfx("tick")
				end
			end)
		end
		it.view = function(anim)
			if not seg.Parent then return end
			for i, o in ipairs(opts) do
				local on_ = o == it.value
				buttons[i].TextColor3 = on_ and WHITE or C.mute
				if on_ then move(xs[i], xs[i] + widths[i], not anim) end
			end
		end
		it.view(false)
		return e
	end
	-- expandable list (multi select, or single select with many options)
	local e = pg:tile(it, 36, true)
	nameLabel(e, it, 0, 18, 200)
	local summary = text({ Text = "", TextSize = 12, FontFace = F_MED, TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = V2(1, 0.5),
		Position = U2(1, -30, 0, 18), Size = U2(0.5, -30, 0, 16), TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 3, Parent = e.face })
	bind(summary, { TextColor3 = "aqua" })
	local chev = icon("chevron", 12, e.face, "mute")
	chev.AnchorPoint = V2(1, 0.5)
	chev.Position = U2(1, -12, 0, 18)
	chev.ZIndex = 3
	local list = frame({ BackgroundTransparency = 1, Position = off(12, 36), Size = U2(1, -24, 0, 0), ZIndex = 3, Parent = e.face })
	local chips = {}
	local function isOn(o)
		if it.multi then return table.find(it.value, o) ~= nil end
		return it.value == o
	end
	for _, o in ipairs(opts) do
		local w = textWidth(tostring(o), 12) + 34
		local b = inst("TextButton", { AutoButtonColor = false, Text = "", Size = off(w, 24), ZIndex = 4, Parent = list })
		corner(b, 7)
		bind(b, { BackgroundColor3 = "track", BackgroundTransparency = "trackT" })
		local box = frame({ AnchorPoint = V2(0, 0.5), Position = U2(0, 7, 0.5, 0), Size = off(14, 14), ZIndex = 5, Parent = b })
		corner(box, 4)
		local boxStroke = strokeOf(box, C.mute, 1.5, 0)
		local check = icon("check", 10, box, nil)
		check.AnchorPoint = V2(0.5, 0.5)
		check.Position = UDim2.fromScale(0.5, 0.5)
		check.ZIndex = 6
		local l = text({ Text = tostring(o), TextSize = 12, Position = off(26, 0), Size = U2(1, -30, 1, 0), ZIndex = 5, Parent = b })
		chips[#chips + 1] = { b = b, box = box, boxStroke = boxStroke, check = check, label = l, opt = o, w = w }
		b.MouseButton1Click:Connect(function()
			if it.multi then
				local nv = {}
				for _, x in ipairs(opts) do
					if (x == o) ~= isOn(x) then nv[#nv + 1] = x end
				end
				it:set(nv, true)
			else
				it:set(o, true)
			end
			sfx("tick")
		end)
	end
	local listH = chipLayout(chips, pg.cw - 24)
	for _, c in ipairs(chips) do
		c.b.Position = off(c.x, c.y)
	end
	list.Size = U2(1, -24, 0, listH)
	e.open = false
	it.view = function()
		if not list.Parent then return end
		local names = {}
		for _, c in ipairs(chips) do
			local onv = isOn(c.opt)
			if onv then names[#names + 1] = tostring(c.opt) end
			c.box.BackgroundColor3 = onv and C.hydro or C.track
			c.box.BackgroundTransparency = onv and 0 or 1
			c.boxStroke.Color = onv and C.hydro or C.mute
			if c.check:IsA("ImageLabel") then c.check.ImageTransparency = onv and 0 or 1 else c.check.TextTransparency = onv and 0 or 1 end
			c.label.TextColor3 = onv and C.text or C.mute
		end
		summary.Text = #names == 0 and "None" or (#names > 2 and (#names .. " selected") or table.concat(names, ", "))
	end
	it.view()
	local head = hitbox({ Size = U2(1, 0, 0, 36), ZIndex = 6, Parent = e.face })
	head.MouseButton1Click:Connect(function()
		e.open = not e.open
		e.h = e.open and (36 + listH + 10) or 36
		pop(chev, 0.25, { Rotation = e.open and 180 or 0 })
		sfx("tick")
		pg:layout(true)
		if e.open then
			for i, c in ipairs(chips) do
				c.b.Position = off(c.x, c.y - 6)
				pop(c.b, 0.3, { Position = off(c.x, c.y) }, (i - 1) * 0.03)
			end
		end
	end)
	return e
end

function Build.bind(pg, it)
	local win = pg.win
	local e = pg:tile(it, 36, false)
	nameLabel(e, it, 0.5, 0, 80)
	local cap = frame({ AnchorPoint = V2(1, 0.5), Position = U2(1, -12, 0.5, 0), Size = off(40, 20), ZIndex = 3, Parent = e.face })
	corner(cap, 6)
	bind(cap, { BackgroundColor3 = "track", BackgroundTransparency = "trackT" })
	local capStroke = strokeOf(cap, C.gold, 1, 0)
	bind(capStroke, { Color = "gold" })
	local lbl = text({ Text = "", TextSize = 11, FontFace = F_BOLD, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = cap })
	bind(lbl, { TextColor3 = "gold" })
	local listening = false
	local SHORT = { RightShift = "RShift", LeftShift = "LShift", RightControl = "RCtrl", LeftControl = "LCtrl", RightAlt = "RAlt", LeftAlt = "LAlt", Delete = "Del", Insert = "Ins" }
	it.view = function()
		if not cap.Parent then return end
		local t = listening and "..." or (SHORT[it.value] or tostring(it.value))
		lbl.Text = t
		cap.Size = off(math.max(40, textWidth(t, 11, Enum.Font.GothamBold) + 18), 20)
	end
	it.view()
	clicker(e, function()
		if listening then return end
		listening = true
		ripple(e.face, win.scale.Scale)
		sfx("tick")
		it.view()
		capStroke.Color = C.aqua
		local pulse = loop("page", capStroke, TweenInfo.new(0.6, EQ.Sine, ED.InOut, -1, true), { Thickness = 2.5 })
		win:listenKey(function(kc)
			listening = false
			pulse:Cancel()
			capStroke.Thickness = 1
			capStroke.Color = C.gold
			it:set(kc.Name, false)
			safeCall(it.opts.OnChangedCallback, kc)
			sfx("ok")
			toast("Keybind", it.name .. ": " .. (SHORT[kc.Name] or kc.Name), 2)
		end)
	end)
	return e
end

function Build.button(pg, it)
	local win = pg.win
	local danger = it.opts.Danger == true
	local e = pg:tile(it, 36, false)
	local nm = nameLabel(e, it, 0.5, 0, 50)
	if danger then nm.TextColor3 = rgb(255, 143, 156) end
	local bi = frame({ AnchorPoint = V2(1, 0.5), Position = U2(1, -10, 0.5, 0), Size = off(24, 24), BackgroundTransparency = 1, ZIndex = 3, Parent = e.face })
	corner(bi, -1)
	local biStroke = strokeOf(bi, danger and rgb(255, 143, 156) or C.aqua, 1, 0.55)
	if not danger then bind(biStroke, { Color = "aqua" }) end
	local arrow = icon("arrow", 13, bi, (not danger) and "aqua" or nil)
	arrow.AnchorPoint = V2(0.5, 0.5)
	arrow.Position = UDim2.fromScale(0.5, 0.5)
	arrow.ZIndex = 4
	if danger then
		if arrow:IsA("ImageLabel") then arrow.ImageColor3 = rgb(255, 143, 156) else arrow.TextColor3 = rgb(255, 143, 156) end
	end
	local check = icon("check", 13, bi, nil)
	check.AnchorPoint = V2(0.5, 0.5)
	check.Position = UDim2.fromScale(0.5, 0.5)
	check.ZIndex = 4
	if check:IsA("ImageLabel") then check.ImageTransparency = 1 else check.TextTransparency = 1 end
	local drain = frame({ AnchorPoint = V2(0, 1), Position = UDim2.fromScale(0, 1), Size = U2(0, 0, 0, 2), BackgroundColor3 = rgb(255, 143, 156), ZIndex = 7, Parent = e.face })
	local armed, armToken = false, 0
	local function setIcon(isCheck)
		local a, c = arrow, check
		if a:IsA("ImageLabel") then
			tw(a, 0.15, { ImageTransparency = isCheck and 1 or 0 })
			tw(c, 0.2, { ImageTransparency = isCheck and 0 or 1 })
		else
			a.TextTransparency = isCheck and 1 or 0
			c.TextTransparency = isCheck and 0 or 1
		end
	end
	clicker(e, function()
		if danger and not armed then
			armed = true
			armToken += 1
			local token = armToken
			nm.Text = "Tap again to confirm"
			sfx("warn")
			drain.Size = U2(1, 0, 0, 2)
			tw(drain, 2.6, { Size = U2(0, 0, 0, 2) }, EQ.Linear)
			local x0 = e.face.Position
			for i, dx in ipairs({ -3, 3, -2, 1, 0 }) do
				task.delay(i * 0.05, function()
					if e.face.Parent then e.face.Position = x0 + off(dx, 0) end
				end)
			end
			task.delay(2.6, function()
				if armed and token == armToken then
					armed = false
					if nm.Parent then nm.Text = it.name end
				end
			end)
			return
		end
		armed = false
		armToken += 1
		nm.Text = it.name
		drain.Size = U2(0, 0, 0, 2)
		-- water floods out from the tap, the arrow turns into a check
		local x, y = mouseIn(e.face, win.scale.Scale)
		local flood = frame({ AnchorPoint = V2(0.5, 0.5), Position = off(x, y), Size = off(0, 0), BackgroundTransparency = 0.7, ZIndex = 2, Parent = e.face })
		corner(flood, -1)
		flood.BackgroundColor3 = danger and rgb(255, 110, 130) or C.hydro
		tw(flood, 0.5, { Size = off(e.face.AbsoluteSize.X * 2.4 / win.scale.Scale, e.face.AbsoluteSize.X * 2.4 / win.scale.Scale), BackgroundTransparency = 1 })
		task.delay(0.55, function() flood:Destroy() end)
		bi.BackgroundColor3 = danger and rgb(224, 86, 106) or C.hydro
		tw(bi, 0.15, { BackgroundTransparency = 0 })
		pop(bi, 0.3, { Size = off(28, 28), Rotation = -12 })
		setIcon(true)
		splash(bi, danger and { rgb(255, 143, 156), WHITE } or { C.gold, C.aqua, WHITE }, 10)
		sfx("ok")
		task.delay(0.35, function()
			if bi.Parent then pop(bi, 0.3, { Size = off(24, 24), Rotation = 0 }) end
		end)
		task.delay(0.9, function()
			if bi.Parent then
				tw(bi, 0.25, { BackgroundTransparency = 1 })
				setIcon(false)
			end
		end)
		safeCall(it.cb)
	end)
	return e
end

function Build.input(pg, it)
	local e = pg:tile(it, 36, true)
	nameLabel(e, it, 0.5, 0, 240)
	local box = inst("TextBox", { Text = it.value or "", PlaceholderText = it.opts.PlaceholderText or "", TextSize = 12, FontFace = F_REG,
		ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
		AnchorPoint = V2(1, 0.5), Position = U2(1, -10, 0.5, 0), Size = U2(0.48, 0, 0, 24), ZIndex = 4, Parent = e.face })
	corner(box, 7)
	bind(box, { BackgroundColor3 = "track", BackgroundTransparency = "trackT", TextColor3 = "text", PlaceholderColor3 = "mute" })
	inst("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = box })
	local bst = strokeOf(box, C.aqua, 1, 1)
	bind(bst, { Color = "aqua" })
	box.Focused:Connect(function() tw(bst, 0.2, { Transparency = 0.2 }) end)
	box.FocusLost:Connect(function()
		tw(bst, 0.2, { Transparency = 1 })
		it.value = box.Text
		safeCall(it.cb, box.Text)
		if it.opts.RemoveTextAfterFocusLost then box.Text = "" end
	end)
	it.view = function()
		if box.Parent and box.Text ~= (it.value or "") then box.Text = it.value or "" end
	end
	return e
end

local PRESETS = { rgb(74, 163, 255), rgb(143, 220, 255), rgb(220, 184, 113), WHITE, rgb(255, 79, 109), rgb(90, 255, 120) }
function Build.color(pg, it)
	local win = pg.win
	local e = pg:tile(it, 36, false)
	nameLabel(e, it, 0.5, 0, 60)
	local sw = frame({ AnchorPoint = V2(1, 0.5), Position = U2(1, -12, 0.5, 0), Size = off(28, 16), ZIndex = 3, Parent = e.face })
	corner(sw, 5)
	strokeOf(sw, WHITE, 1.5, 0.3)
	it.view = function()
		if sw.Parent then sw.BackgroundColor3 = it.value end
	end
	it.view()
	clicker(e, function()
		ripple(e.face, win.scale.Scale)
		sfx("tick")
		win:openPicker(e.face, it)
	end)
