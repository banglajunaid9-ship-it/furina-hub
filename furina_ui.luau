	FurinaUI 1.0 | Hydro interface for Roblox scripts
	Port of ui_preview/furina_ui_v11.html (the approved design).

	local UI = loadstring(game:HttpGet("<raw url>/furina_ui.luau"))()
	local Window = UI:CreateWindow({ Name = "Furina Hub", Subtitle = "Silent Assassins" })
	local Tab = Window:CreateTab({ Name = "Combat", Icon = "combat" })
