end

function Build.label(pg, it)
	local style = it.opts.Style or 2
	local cw = pg.cw
	local textH = TextService:GetTextSize(it.name, 12, Enum.Font.Gotham, V2(cw - 44, 1000)).Y
	local h = math.max(34, textH + 18)
	local slot = frame({ BackgroundTransparency = 1, Size = off(cw, h), Parent = pg.canvas })
	local face = frame({ Size = UDim2.fromScale(1, 1), Parent = slot })
	corner(face, 10)
	bind(face, { BackgroundColor3 = "gold" })
	face.BackgroundTransparency = style == 3 and 0.86 or 0.93
	local st = strokeOf(face, C.gold, 1, style == 3 and 0.35 or 0.6)
	bind(st, { Color = "gold" })
	local ic = icon("info", 14, face, "gold")
	ic.Position = off(12, 10)
	local l = text({ Text = it.name, TextSize = 12, FontFace = F_REG, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top,
		Position = off(34, 9), Size = U2(1, -44, 1, -12), Parent = face })
	bind(l, { TextColor3 = style == 1 and "text" or "mute" })
	it.view = function()
		if l.Parent then l.Text = it.name end
	end
	return pg:add({ slot = slot, face = face, h = h, wide = true, kind = "note", item = it })
end

function Build.section(pg, it, static)
	local slot = frame({ BackgroundTransparency = 1, Size = off(pg.cw, 18), Parent = pg.canvas })
	local dia = frame({ AnchorPoint = V2(0.5, 0.5), Position = U2(0, 5, 0.5, 0), Size = off(5, 5), Rotation = 45, BackgroundTransparency = 1, Parent = slot })
	bind(strokeOf(dia, C.gold, 1, 0), { Color = "gold" })
	local fill = frame({ Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = dia })
	bind(fill, { BackgroundColor3 = "gold" })
	local title = spaced(it.name)
	local tl = text({ Text = title, TextSize = 10, FontFace = F_BOLD, Position = off(16, 0), Size = U2(0, textWidth(title, 10, Enum.Font.GothamBold) + 4, 1, 0), Parent = slot })
	bind(tl, { TextColor3 = "gold" })
	local cnt = text({ Text = "", TextSize = 10, FontFace = F_MED, Position = off(16 + tl.Size.X.Offset + 4, 0), Size = off(80, 18), TextTransparency = 1, Parent = slot })
	bind(cnt, { TextColor3 = "mute" })
	local line = frame({ AnchorPoint = V2(0, 0.5), Position = U2(0, 22 + tl.Size.X.Offset, 0.5, 0), Size = U2(1, -(46 + tl.Size.X.Offset), 0, 1), Parent = slot })
	bind(line, { BackgroundColor3 = "gold" })
	inst("UIGradient", { Transparency = NumberSequence.new(0.4, 1), Parent = line })
	local e = pg:add({ slot = slot, h = 18, kind = "sec", item = it, folded = false })
	if static then return e end
	local chev = icon("chevron", 11, slot, "mute")
	chev.AnchorPoint = V2(1, 0.5)
	chev.Position = U2(1, -2, 0.5, 0)
	local key = (it.tab and it.tab.name or "?") .. "/" .. it.name
	e.folded = S.Collapsed[key] == true
	local function paint(anim)
		local hidden = 0
		local after = false
		for _, x in ipairs(pg.els) do
			if x == e then
				after = true
			elseif after then
				if x.kind == "sec" then break end
				hidden += 1
			end
		end
		cnt.Text = e.folded and ("· " .. hidden .. " hidden") or ""
		fill.BackgroundTransparency = e.folded and 0 or 1
		if anim then
			pop(chev, 0.25, { Rotation = e.folded and -90 or 0 })
			tw(cnt, 0.2, { TextTransparency = e.folded and 0 or 1 })
		else
			chev.Rotation = e.folded and -90 or 0
			cnt.TextTransparency = e.folded and 0 or 1
		end
	end
	e.paint = paint
	local b = hitbox({ Size = UDim2.fromScale(1, 1), Parent = slot })
	b.MouseButton1Click:Connect(function()
		e.folded = not e.folded
		S.Collapsed[key] = e.folded or nil
		saveSettings()
		sfx("tick")
		paint(true)
		pg:layout(true)
	end)
	return e
end

------------------------------------------------------------------------------------------------------
-- Tab API (Luna-compatible)
------------------------------------------------------------------------------------------------------
local function addItem(tab, it)
	tab.items[#tab.items + 1] = it
	if W and W.current == tab then W:showTab(tab, false, true) end
	return handle(it)
end
function Tab:CreateSection(name)
	if type(name) == "table" then name = name.Name or name.Text end
	return addItem(self, newItem("section", self, { Name = tostring(name or "") }))
end
function Tab:CreateDivider() return self:CreateSection("") end
function Tab:CreateLabel(opts)
	if type(opts) == "string" then opts = { Text = opts } end
	return addItem(self, newItem("label", self, opts))
end
Tab.CreateParagraph = function(self, opts)
	return self:CreateLabel({ Text = (opts.Title and (opts.Title .. ": ") or "") .. (opts.Content or opts.Text or ""), Style = 2 })
end
function Tab:CreateToggle(opts)
	local it = newItem("toggle", self, opts)
	it.value = opts.CurrentValue == true
	return addItem(self, it)
end
function Tab:CreateSlider(opts)
	local it = newItem("slider", self, opts)
	opts.Range = opts.Range or { 0, 100 }
	it.value = math.clamp(tonumber(opts.CurrentValue) or opts.Range[1], opts.Range[1], opts.Range[2])
	return addItem(self, it)
end
function Tab:CreateDropdown(opts)
	local it = newItem("dropdown", self, opts)
	it.multi = opts.MultipleOptions == true
	local cur = opts.CurrentOption
	if it.multi then
		it.value = type(cur) == "table" and table.clone(cur) or (cur and { cur } or {})
	else
		it.value = type(cur) == "table" and cur[1] or cur or (opts.Options and opts.Options[1])
	end
	return addItem(self, it)
end
function Tab:CreateBind(opts)
	local it = newItem("bind", self, opts)
	local cb = opts.CurrentBind
	it.value = typeof(cb) == "EnumItem" and cb.Name or tostring(cb or "None")
	return addItem(self, it)
end
Tab.CreateKeybind = Tab.CreateBind
function Tab:CreateColorPicker(opts)
	local it = newItem("color", self, opts)
	it.value = opts.Color or opts.CurrentValue or WHITE
	return addItem(self, it)
end
function Tab:CreateInput(opts)
	local it = newItem("input", self, opts)
	it.value = tostring(opts.CurrentValue or "")
	return addItem(self, it)
end
function Tab:CreateButton(opts)
	return addItem(self, newItem("button", self, opts))
end

local function buildItem(pg, it)
	local k = it.kind
	if k == "section" then return Build.section(pg, it) end
	if k == "toggle" then return Build.toggle(pg, it) end
	if k == "slider" then return Build.slider(pg, it) end
	if k == "dropdown" then return Build.dropdown(pg, it) end
	if k == "bind" then return Build.bind(pg, it) end
	if k == "button" then return Build.button(pg, it) end
	if k == "input" then return Build.input(pg, it) end
	if k == "color" then return Build.color(pg, it) end
	if k == "label" then return Build.label(pg, it) end
	return nil
end

------------------------------------------------------------------------------------------------------
-- window methods
------------------------------------------------------------------------------------------------------
function Window:help(desc)
	if not self.footHelp then return end
	if desc then
		self.footHelp.Text = desc
		self.footHelp.Visible = true
		self.footChips.Visible = false
	else
		self.footHelp.Visible = false
		self.footChips.Visible = true
	end
end

function Window:allItems()
	local out = {}
	for _, tab in ipairs(self.tabs) do
		if not tab.internal then
			for _, it in ipairs(tab.items) do
				out[#out + 1] = it
			end
		end
	end
	return out
end

function Window:renderFoot()
	if not self.footChips then return end
	for _, c in ipairs(self.footChips:GetChildren()) do
		if c:IsA("GuiObject") then c:Destroy() end
	end
	local n = 0
	for _, it in ipairs(self:allItems()) do
		if it.kind == "toggle" and it.value then
			n += 1
			if n > 4 then break end
			local w = textWidth(it.name, 11) + 22
			local chip = frame({ Size = off(w, 18), LayoutOrder = n, Parent = self.footChips })
			corner(chip, 9)
			bind(chip, { BackgroundColor3 = "hydro" })
			chip.BackgroundTransparency = 0.82
			local dot = frame({ AnchorPoint = V2(0, 0.5), Position = U2(0, 7, 0.5, 0), Size = off(5, 5), Parent = chip })
			corner(dot, -1)
			bind(dot, { BackgroundColor3 = "aqua" })
			local l = text({ Text = it.name, TextSize = 11, Position = off(15, 0), Size = U2(1, -15, 1, 0), Parent = chip })
			bind(l, { TextColor3 = "text" })
		end
	end
	if n == 0 then
		local l = text({ Text = "No features on", TextSize = 11, Size = off(140, 18), Parent = self.footChips })
		bind(l, { TextColor3 = "mute" })
	end
end

function Window:onItemChanged(it)
	if it.kind == "toggle" then
		if self.footDirty then return end
		self.footDirty = true
		task.defer(function()
			self.footDirty = false
			self:renderFoot()
			if self.current and self.current.home and self.refreshOnList then self.refreshOnList() end
		end)
	end
end

-- one global drag handler (sliders, colour picker, launcher) instead of one connection per control
function Window:startDrag(onMove, onEnd)
	self.drag = { move = onMove, done = onEnd }
end
function Window:listenKey(fn) self.keyListener = fn end

function Window:setTitle(actText, name)
	self.actLabel.Text = spaced(actText)
	for _, c in ipairs(self.titleBox:GetChildren()) do
		if c:IsA("GuiObject") then c:Destroy() end
	end
	for i = 1, #name do
		local ch = name:sub(i, i)
		local w = math.max(5, textWidth(ch, 17, Enum.Font.Merriweather) + 1)
		local holder = frame({ BackgroundTransparency = 1, Size = off(w, 22), LayoutOrder = i, Parent = self.titleBox })
		local l = text({ Text = ch, TextSize = 17, FontFace = F_TITLE, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Parent = holder })
		bind(l, { TextColor3 = i == 1 and "gold" or "text" })
		if not LITE then
			l.Position = off(0, 10)
			l.TextTransparency = 1
			pop(l, 0.45, { Position = off(0, 0) }, (i - 1) * 0.035)
			tw(l, 0.35, { TextTransparency = 0 }, EQ.Quint, ED.Out, (i - 1) * 0.035)
		end
	end
end

function Window:actFor(tab)
	if not tab then return "" end
	if tab.home then return "PROLOGUE" end
	if tab.internal == "settings" then return "BACKSTAGE" end
	return "ACT " .. (ROMAN[tab.act] or tostring(tab.act))
end

function Window:moveIndicator(index, instant)
	local y = (index - 1) * 32
	if self.tabs[index] and self.tabs[index].internal == "settings" then y += 8 end
	self.moveInd(y, y + 30, instant)
end

function Window:showTab(tab, animate, quiet)
	if self.search and self.search ~= "" and not quiet then
		self.search = ""
		self.searchBox.Text = ""
	end
	local idx = table.find(self.tabs, tab) or 1
	local changed = self.current ~= tab
	self.current = tab
	for i, t in ipairs(self.tabs) do
		local on_ = i == idx
		if t.iconObj then
			local key = on_ and "aqua" or "mute"
			if t.iconObj:IsA("ImageLabel") then
				tw(t.iconObj, 0.2, { ImageColor3 = C[key] })
				bind(t.iconObj, { ImageColor3 = key })
			else
				bind(t.iconObj, { TextColor3 = key })
			end
		end
	end
	self:moveIndicator(idx, not animate)
	if self.titleTab ~= tab then
		self.titleTab = tab
		self:setTitle(self:actFor(tab), tab.name)
	end
	self:buildPage(tab, animate and changed, quiet)
end

function Window:buildPage(tab, animate, quiet)
	local old = self.page
	local pg = self:newPage()
	self.page = pg
	local scroll = old and not animate and old.canvas.CanvasPosition
	if tab == "search" then
		local q = self.search:lower()
		local found = {}
		for _, it in ipairs(self:allItems()) do
			if it.kind ~= "section" and it.kind ~= "label" and it.name:lower():find(q, 1, true) then found[#found + 1] = it end
		end
		local hits = #found
		Build.section(pg, { name = hits .. " result" .. (hits == 1 and "" or "s") }, true)
		for _, it in ipairs(found) do
			buildItem(pg, it)
		end
		if hits == 0 then
			Build.label(pg, { name = "Nothing on stage by that name.", opts = { Style = 1 } })
		end
	elseif tab.home then
		self:buildHome(pg)
	else
		if tab.internal == "settings" then self:syncSettings() end
		for _, it in ipairs(tab.items) do
			buildItem(pg, it)
		end
		for _, e in ipairs(pg.els) do
			if e.paint then e.paint(false) end
		end
	end
	pg:layout(false)
	if scroll then pg.canvas.CanvasPosition = scroll end
	if old then
		local oc = old.canvas
		if animate and not LITE then
			tw(oc, 0.16, { Position = off(0, 8) })
			task.delay(0.17, function() oc:Destroy() end)
		else
			oc:Destroy()
		end
	end
	if animate and not quiet then
		for i, e in ipairs(pg.els) do
			local delay = 0.05 + math.min(i, 14) * 0.03
			local target = e.slot.Position
			e.slot.Position = target + off(0, 14)
			pop(e.slot, 0.45, { Position = target }, delay)
			fadeIn(e.slot, delay)
		end
	end
	setLoops("page", self.visible)
end

function Window:CreateTab(opts)
	opts = type(opts) == "table" and opts or { Name = tostring(opts) }
	local tab = setmetatable({ name = opts.Name or "Tab", icon = opts.Icon or "misc", items = {}, win = self }, Tab)
	local insertAt = #self.tabs
	if self.tabs[#self.tabs] and self.tabs[#self.tabs].internal == "settings" then
		table.insert(self.tabs, insertAt, tab)
	else
		self.tabs[#self.tabs + 1] = tab
	end
	local act = 0
	for _, t in ipairs(self.tabs) do
		if not t.internal and not t.home then
			act += 1
			t.act = act
		end
	end
	self:buildRail()
	self:loaderStep("Preparing " .. tab.name)
	return tab
end

function Window:buildRail()
	for _, c in ipairs(self.tabsFrame:GetChildren()) do
		if c.Name == "TabButton" then c:Destroy() end
	end
	for i, tab in ipairs(self.tabs) do
		local y = (i - 1) * 32 + (tab.internal == "settings" and 8 or 0)
		local b = hitbox({ Name = "TabButton", Position = off(0, y), Size = off(34, 30), ZIndex = 4, Parent = self.tabsFrame })
		local ic = icon(tab.icon, 16, b, self.current == tab and "aqua" or "mute")
		ic.AnchorPoint = V2(0.5, 0.5)
		ic.Position = UDim2.fromScale(0.5, 0.5)
		ic.ZIndex = 5
		tab.iconObj = ic
		local tip = frame({ AnchorPoint = V2(0, 0.5), Position = U2(1, 12, 0.5, 0), Size = off(textWidth(tab.name, 12) + 18, 22), Visible = false, ZIndex = 30, Parent = b })
		corner(tip, 7)
		bind(tip, { BackgroundColor3 = "panel2" })
		bind(strokeOf(tip, C.line, 1, C.lineT), { Color = "line", Transparency = "lineT" })
		local tl = text({ Text = tab.name, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), ZIndex = 31, Parent = tip })
		bind(tl, { TextColor3 = "text" })
		b.MouseEnter:Connect(function()
			if not self.phone then
				tip.Visible = true
				tip.Position = U2(1, 6, 0.5, 0)
				tw(tip, 0.16, { Position = U2(1, 12, 0.5, 0) })
			end
			if not LITE then
				ic.Rotation = 0
				pop(ic, 0.15, { Rotation = -12 })
				task.delay(0.15, function() pop(ic, 0.3, { Rotation = 0 }) end)
			end
		end)
		b.MouseLeave:Connect(function() tip.Visible = false end)
		b.MouseButton1Down:Connect(function()
			if self.current ~= tab then sfx("tab") end
			ic.Size = off(13, 13)
			pop(ic, 0.3, { Size = off(16, 16) })
			self:showTab(tab, true)
		end)
	end
	if self.current then self:moveIndicator(table.find(self.tabs, self.current) or 1, true) end
end

